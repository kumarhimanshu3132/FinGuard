@model FinGuard.Models.AdminUser

@{
    ViewData["Title"] = "Administrator Profile";
    string maxDate = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd");
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-id-badge text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Administrator Profile
        </h1>
        <p class="fg-page-subtitle">Administrative account credentials, assigned role permissions, and officer details.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" id="btnEditProfile" class="fg-btn fg-btn-primary fg-btn-sm">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            <span>Edit Profile</span>
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div id="profileAlertSuccess" class="fg-alert fg-alert-success" role="alert">
        <i class="fa-solid fa-circle-check fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Info"] != null)
{
    <div id="profileAlertInfo" class="fg-alert fg-alert-info" role="alert">
        <i class="fa-solid fa-circle-info fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Info"]</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="fg-card">
            <form asp-action="UpdateProfile" method="post" id="profileForm">
                @Html.AntiForgeryToken()

                <!-- Account Credentials (System Managed) -->
                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">System Credentials & Role</h2>
                    <p class="fg-form-section-desc">System authentication parameters managed by database directory.</p>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="fg-form-label">System Username</label>
                            <input type="text" class="form-control" value="@Model.Username" readonly />
                            <div class="fg-input-hint">Unique authentication handle.</div>
                        </div>

                        <div class="col-md-5">
                            <label class="fg-form-label">Registered Email</label>
                            <input type="email" class="form-control" value="@Model.Email" readonly />
                            <div class="fg-input-hint">Primary alert & recovery email.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="fg-form-label">Authorization Role</label>
                            <div class="pt-1">
                                <span class="fg-badge fg-badge-info fs-6 px-3 py-2">
                                    <span class="fg-badge-dot"></span>
                                    @Model.Role
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personal Information (Editable) -->
                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">Officer Demographics</h2>
                    <p class="fg-form-section-desc">Personal details attached to this administrative record.</p>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="fg-form-label" for="fullNameInput">
                                Full Legal Name <span class="required text-danger">*</span>
                            </label>
                            <input type="text" id="fullNameInput" name="fullName" class="form-control"
                                   value="@Model.FullName" placeholder="Enter full name" readonly
                                   oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '').replace(/\s{2,}/g, ' ');"
                                   required />
                            <div class="fg-input-hint">Displayed on collection receipts and logs.</div>
                        </div>

                        <div class="col-md-5">
                            <label class="fg-form-label" for="dobInput">
                                Date of Birth <span class="required text-danger">*</span>
                            </label>
                            <input type="date" id="dobInput" name="dateOfBirth" class="form-control"
                                   value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" max="@maxDate" readonly required />
                        </div>
                    </div>
                </div>

                <!-- Actions (Hidden until Edit is clicked) -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3" id="saveActions" style="display: none;">
                    <button type="button" id="btnCancelProfile" class="fg-btn fg-btn-secondary">Cancel</button>
                    <button type="submit" class="fg-btn fg-btn-primary">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        <span>Save Profile Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btnEdit = document.getElementById('btnEditProfile');
            const btnCancel = document.getElementById('btnCancelProfile');
            const saveActions = document.getElementById('saveActions');
            const fullNameInput = document.getElementById('fullNameInput');
            const dobInput = document.getElementById('dobInput');
            const profileForm = document.getElementById('profileForm');

            if (btnEdit) {
                btnEdit.addEventListener('click', function () {
                    if (fullNameInput) fullNameInput.removeAttribute('readonly');
                    if (dobInput) dobInput.removeAttribute('readonly');
                    this.style.display = 'none';
                    if (saveActions) saveActions.style.display = 'flex';
                    if (fullNameInput) fullNameInput.focus();
                });
            }

            if (btnCancel) {
                btnCancel.addEventListener('click', function () {
                    if (fullNameInput) fullNameInput.setAttribute('readonly', 'readonly');
                    if (dobInput) dobInput.setAttribute('readonly', 'readonly');
                    if (saveActions) saveActions.style.display = 'none';
                    if (btnEdit) btnEdit.style.display = 'inline-flex';
                    if (profileForm) profileForm.reset();
                });
            }

            ['profileAlertSuccess', 'profileAlertInfo'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    setTimeout(() => {
                        el.style.transition = 'opacity 400ms ease';
                        el.style.opacity = '0';
                        setTimeout(() => el.remove(), 400);
                    }, 3500);
                }
            });
        })();
    </script>
}