@model FinGuard.Models.SetNewPasswordViewModel

@{
    ViewData["Title"] = "Create New Password - FinGuard";
    Layout = "_BorrowerLayout";
}

<div class="row justify-content-center py-3 py-md-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
        <div class="bp-card p-3 p-sm-4 p-md-5">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="bp-brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.45rem; background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); color: #fff; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                </div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-light border rounded-pill mb-2 small text-secondary fw-semibold">
                    <i class="fa-solid fa-lock text-indigo"></i> Password Update Required
                </div>
                <h1 class="fs-4 fw-bold text-dark mb-1">Set Your New Password</h1>
                <p class="text-secondary small mb-0">You logged in using a temporary password. Please set a secure permanent password to continue.</p>
            </div>

            <!-- Feedback Notifications -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-start gap-2 p-3 mb-4 rounded-3 small border-danger-subtle" role="alert">
                    <i class="fa-solid fa-circle-exclamation mt-1 flex-shrink-0 text-danger" aria-hidden="true"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info d-flex align-items-start gap-2 p-3 mb-4 rounded-3 small border-info-subtle" role="alert">
                    <i class="fa-solid fa-circle-info mt-1 flex-shrink-0 text-primary" aria-hidden="true"></i>
                    <div>@TempData["Info"]</div>
                </div>
            }

            <!-- Set Password Form -->
            <form asp-action="SetNewPassword" method="post" id="setNewPasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Account Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        </span>
                        <input type="text" class="form-control bg-light border-start-0" value="@Model.Email" readonly />
                    </div>
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary mb-1">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        </span>
                        <input asp-for="NewPassword" type="password" id="newPasswordInput"
                               class="form-control border-start-0 border-end-0" placeholder="Enter new password (min. 8 chars)"
                               autocomplete="new-password" required minlength="8" />
                        <button type="button" class="btn btn-outline-secondary border-start-0 bp-toggle-password"
                                data-target="newPasswordInput" aria-label="Toggle password visibility">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary mb-1">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="fa-solid fa-lock-open" aria-hidden="true"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput"
                               class="form-control border-start-0 border-end-0" placeholder="Re-enter your new password"
                               autocomplete="new-password" required minlength="8" />
                        <button type="button" class="btn btn-outline-secondary border-start-0 bp-toggle-password"
                                data-target="confirmPasswordInput" aria-label="Toggle password visibility">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password Requirements Checklist -->
                <div class="p-3 bg-light rounded-3 mb-4 small border">
                    <div class="fw-semibold text-dark mb-1"><i class="fa-solid fa-list-check text-indigo me-1"></i> Password Requirements:</div>
                    <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.82rem;">
                        <li id="reqLength" class="text-muted">Must be at least 8 characters in length</li>
                        <li id="reqMatch" class="text-muted">Both passwords must match</li>
                    </ul>
                </div>

                <!-- Submit Action -->
                <button type="submit" id="btnSubmitNewPassword" class="bp-btn bp-btn-primary w-100 py-2 fs-6 mb-3">
                    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i> Save Password & Proceed to Dashboard
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const newPwd = document.getElementById('newPasswordInput');
            const confirmPwd = document.getElementById('confirmPasswordInput');
            const reqLength = document.getElementById('reqLength');
            const reqMatch = document.getElementById('reqMatch');
            const form = document.getElementById('setNewPasswordForm');
            const submitBtn = document.getElementById('btnSubmitNewPassword');

            function updateRequirements() {
                if (newPwd.value.length >= 8) {
                    reqLength.classList.remove('text-muted', 'text-danger');
                    reqLength.classList.add('text-success', 'fw-semibold');
                    reqLength.innerHTML = '<i class="fa-solid fa-check me-1"></i> At least 8 characters in length';
                } else {
                    reqLength.classList.remove('text-success', 'fw-semibold');
                    reqLength.classList.add('text-muted');
                    reqLength.innerHTML = 'Must be at least 8 characters in length';
                }

                if (confirmPwd.value && newPwd.value === confirmPwd.value) {
                    reqMatch.classList.remove('text-muted', 'text-danger');
                    reqMatch.classList.add('text-success', 'fw-semibold');
                    reqMatch.innerHTML = '<i class="fa-solid fa-check me-1"></i> Passwords match';
                } else if (confirmPwd.value) {
                    reqMatch.classList.remove('text-success', 'text-muted');
                    reqMatch.classList.add('text-danger', 'fw-semibold');
                    reqMatch.innerHTML = '<i class="fa-solid fa-xmark me-1"></i> Passwords do not match';
                } else {
                    reqMatch.classList.remove('text-success', 'text-danger', 'fw-semibold');
                    reqMatch.classList.add('text-muted');
                    reqMatch.innerHTML = 'Both passwords must match';
                }
            }

            if (newPwd) newPwd.addEventListener('input', updateRequirements);
            if (confirmPwd) confirmPwd.addEventListener('input', updateRequirements);

            // Toggle password visibility
            document.querySelectorAll('.bp-toggle-password').forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    if (input && icon) {
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }
                });
            });

            if (form && submitBtn) {
                form.addEventListener('submit', function () {
                    if (form.checkValidity() && newPwd.value === confirmPwd.value && newPwd.value.length >= 8) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Updating Password...';
                    }
                });
            }
        });
    </script>
}
