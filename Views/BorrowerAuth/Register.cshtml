@model FinGuard.Models.BorrowerRegisterViewModel

@{
    ViewData["Title"] = "Create Borrower Account";
    Layout = "_BorrowerLayout";
    string maxDate = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="bp-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bp-brand-icon mx-auto mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                </div>
                <h1 class="fs-4 fw-bold text-dark mb-1">Create Your Borrower Account</h1>
                <p class="text-secondary small mb-0">Register your profile to apply for microfinance credit, track installments, and manage active loans.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-start gap-2 p-3 mb-4 rounded-3 small" role="alert">
                    <i class="fa-solid fa-circle-exclamation mt-1 flex-shrink-0" aria-hidden="true"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary">Full Legal Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" required autofocus />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label small fw-semibold text-secondary">Date of Birth *</label>
                        <input asp-for="DateOfBirth" type="date" max="@maxDate" class="form-control" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email address" required />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold text-secondary">10-Digit Mobile Number *</label>
                        <input asp-for="Phone" class="form-control" placeholder="Enter your 10-digit mobile number"
                               pattern="[6-9][0-9]{9}" title="Enter a valid 10-digit mobile number starting with 6, 7, 8, or 9"
                               maxlength="10"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />
                        <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Create Password *</label>
                        <input asp-for="Password" type="password" minlength="8" class="form-control" placeholder="Enter your password" required />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" type="password" minlength="8" class="form-control" placeholder="Confirm your password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MonthlyIncome" class="form-label small fw-semibold text-secondary">Estimated Monthly Income (₹) *</label>
                        <input asp-for="MonthlyIncome" type="number" step="1" min="1000" class="form-control" placeholder="Enter your monthly income" required />
                        <span asp-validation-for="MonthlyIncome" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PinCode" class="form-label small fw-semibold text-secondary">Postal PIN Code *</label>
                        <input asp-for="PinCode" class="form-control" placeholder="Enter your 6-digit PIN code"
                               pattern="[1-9][0-9]{5}" title="Enter a valid 6-digit postal PIN code"
                               maxlength="6"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);" required />
                        <span asp-validation-for="PinCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label small fw-semibold text-secondary">Residential Address *</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter your residential address" required />
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mt-3 p-3 bg-light rounded-3 border d-flex align-items-center gap-2 text-secondary" style="font-size: 0.82rem;">
                    <i class="fa-solid fa-envelope-circle-check text-indigo fs-5 flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <strong>Email Verification:</strong> A secure <strong>6-digit OTP</strong> will be sent to your email address to verify your profile before granting portal access.
                    </div>
                </div>

                <div class="mt-3 text-muted" style="font-size: 0.78rem;">
                    <i class="fa-solid fa-circle-info text-secondary me-1"></i>
                    By registering, you declare that all provided identity and income declarations are authentic. Under institutional microfinance policy, your profile is subject to center underwriting.
                </div>

                <div class="mt-4 pt-2">
                    <button type="submit" id="btnSubmitRegister" class="bp-btn bp-btn-primary w-100 py-2 fs-6">
                        <i class="fa-solid fa-arrow-right me-1" aria-hidden="true"></i> Register & Send Verification Code
                    </button>
                </div>
            </form>

            <div class="text-center small text-secondary pt-3 mt-4 border-top">
                <span>Already have a borrower account? </span>
                <a asp-action="Login" class="fw-semibold text-indigo text-decoration-none">Sign In Here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const submitBtn = document.getElementById('btnSubmitRegister');
            if (form && submitBtn) {
                form.addEventListener('submit', function () {
                    if (form.checkValidity()) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending Verification Code...';
                    }
                });
            }
        });
    </script>
}
