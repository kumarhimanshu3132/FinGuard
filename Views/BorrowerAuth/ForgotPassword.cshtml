@{
    ViewData["Title"] = "Password Recovery";
    Layout = "_BorrowerLayout";
}

<div class="row justify-content-center py-3 py-md-4">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="bp-card p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bp-brand-icon mx-auto mb-3" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="fa-solid fa-key" aria-hidden="true"></i>
                </div>
                <h1 class="fs-4 fw-bold text-dark mb-1">Recover Portal Access</h1>
                <p class="text-secondary small mb-0">Enter your registered email address to receive password recovery assistance.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger p-3 mb-4 rounded-3 small" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i> @ViewBag.Error
                </div>
            }

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success p-3 mb-4 rounded-3 small" role="alert">
                    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i> @ViewBag.Success
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">Registered Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                        <input type="email" name="email" class="form-control" placeholder="Enter your e-mail" required autofocus />
                    </div>
                    <div class="form-text small text-muted">We will verify your borrower record against the institutional database.</div>
                </div>

                <button type="submit" class="bp-btn bp-btn-primary w-100 py-2 mb-3">
                    <i class="fa-solid fa-paper-plane me-1"></i> Send Recovery Link
                </button>
            </form>

            <div class="text-center small text-secondary pt-2 border-top">
                <a asp-action="Login" class="fw-semibold text-indigo text-decoration-none">
                    <i class="fa-solid fa-arrow-left me-1"></i> Return to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
