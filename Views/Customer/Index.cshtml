@model IEnumerable<FinGuard.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
        margin-top: 1rem;
    }

    .header-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    .btn-add {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border: none;
        box-shadow: 0 8px 16px -4px rgba(99, 102, 241, 0.3);
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -4px rgba(99, 102, 241, 0.5);
        color: white;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
        color: var(--text-primary);
    }

    .custom-table th {
        background: rgba(0, 0, 0, 0.2);
        color: var(--text-primary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .custom-table td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        color: var(--text-primary);
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
    }

    .custom-table tr:hover td {
        background: rgba(255, 255, 255, 0.05);
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-pending {
        background: #fef3c7;
        color: #d97706;
    }

    .status-active {
        background: #d1fae5;
        color: #059669;
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center" style="max-width: 1000px; margin: 1rem auto 2.5rem;">
    <h2 class="header-title mb-0" style="color: var(--text-primary);">Customer Directory</h2>
    <a href="/Customer/Create" class="btn-add">+ Onboard Customer</a>
</div>

@if (TempData["Success"] != null)
{
    <div id="alertBoxSuccess" class="alert alert-success d-flex align-items-center"
         style="max-width: 1000px; margin: 0 auto 1.5rem; border-radius: 12px; font-weight: 600; transition: opacity 0.5s ease;">
        <span class="me-2">✅</span> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div id="alertBoxError" class="alert alert-danger d-flex align-items-center"
         style="max-width: 1000px; margin: 0 auto 1.5rem; border-radius: 12px; font-weight: 600; transition: opacity 0.5s ease;">
        <span class="me-2">⚠️</span> @TempData["Error"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="alertBoxErrorMessage" class="alert alert-warning d-flex align-items-center"
         style="max-width: 1000px; margin: 0 auto 1.5rem; border-radius: 12px; font-weight: 600; background: #fffbeb; color: #b45309; border: 1px solid #fcd34d; transition: opacity 0.5s ease;">
        <span class="me-2">⚠️</span> @TempData["ErrorMessage"]
    </div>
}

<script>
    setTimeout(function () {
        var successBox = document.getElementById('alertBoxSuccess');
        if (successBox) {
            successBox.style.opacity = '0';
            setTimeout(function () { successBox.style.display = 'none'; }, 500);
        }

        var errorBox = document.getElementById('alertBoxError');
        if (errorBox) {
            errorBox.style.opacity = '0';
            setTimeout(function () { errorBox.style.display = 'none'; }, 500);
        }

        var errorMessageBox = document.getElementById('alertBoxErrorMessage');
        if (errorMessageBox) {
            errorMessageBox.style.opacity = '0';
            setTimeout(function () { errorMessageBox.style.display = 'none'; }, 500);
        }
    }, 4000);
</script>

<div class="fg-card" style="max-width: 1000px; margin: 0 auto; padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th class="text-light">ID</th>
                    <th class="text-light">Name</th>
                    <th class="text-light">Phone</th>
                    <th class="text-light">Monthly Income</th>
                    <th class="text-light">Credit Status</th>
                    <th class="text-light">KYC Status</th>
                    <th class="text-light">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-light opacity-75">#@item.CustomerId</td>
                            <td class="fw-bold text-light">@item.Name</td>
                            <td class="text-light">@item.CountryCode @item.Phone</td>
                            <td class="fw-bold" style="color: var(--success-color);">₹@item.MonthlyIncome</td>
                            <td>
                                @if (item.CreditStatus == "Active")
                                {
                                    <span class="status-badge status-active">@item.CreditStatus</span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">@item.CreditStatus</span>
                                }
                            </td>
                            <td>
                                @if (item.KycStatus == "Verified")
                                {
                                    <span class="status-badge status-active">Verified</span>
                                }
                                else if (item.KycStatus == "Failed")
                                {
                                    <span class="status-badge" style="background: #fee2e2; color: #991b1b;">Failed</span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">Pending</span>
                                }
                            </td>
                            <td class="d-flex align-items-center gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.CustomerId"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">Edit</a>

                                @if (item.KycStatus == "Pending")
                                {
                                    <a asp-action="VerifyIdentity" asp-route-id="@item.CustomerId" 
                                       class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">Verify Identity</a>
                                }
                                else if (item.KycStatus == "Failed")
                                {
                                    <a asp-action="VerifyIdentity" asp-route-id="@item.CustomerId" 
                                       class="btn btn-sm btn-warning rounded-pill px-3 fw-bold text-dark">Retry KYC</a>
                                }

                                <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="m-0"
                                      onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <h5 class="fw-bold text-light">No customers found</h5>
                            <p class="text-light opacity-75 mb-0">Click "+ Onboard Customer" to add your first member.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>