@model IEnumerable<FinGuard.Models.Customer>

@{
    ViewData["Title"] = "Customer Directory";
    var totalCount = Model != null ? Model.Count() : 0;
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-users text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Customer Directory
            <span class="fg-count-badge">@totalCount Records</span>
        </h1>
        <p class="fg-page-subtitle">Verified borrower registry, KYC compliance tracking, and profile management.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="fg-btn fg-btn-primary fg-btn-sm">
            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
            <span>Onboard Customer</span>
        </a>
    </div>
</div>

<!-- Standardized Flash Alerts -->
@if (TempData["Success"] != null)
{
    <div id="alertBoxSuccess" class="fg-alert fg-alert-success" role="alert">
        <i class="fa-solid fa-circle-check fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div id="alertBoxError" class="fg-alert fg-alert-danger" role="alert">
        <i class="fa-solid fa-circle-exclamation fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Error"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="alertBoxErrorMessage" class="fg-alert fg-alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Table Card with Search & Filters -->
<div class="fg-card fg-card-flush">
    <!-- Filter & Search Bar -->
    <div class="fg-filter-bar">
        <div class="fg-search-input-group">
            <i class="fa-solid fa-magnifying-glass fg-search-icon" aria-hidden="true"></i>
            <input type="text" id="customerSearchInput" class="fg-search-input"
                   placeholder="Search by ID, name, email or phone..." aria-label="Search customers" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="statusFilterSelect" class="fg-filter-select" aria-label="Filter by Credit Status">
                <option value="">All Credit Statuses</option>
                <option value="Active">Active Loan</option>
                <option value="Eligible">Eligible</option>
                <option value="Under Review">Under Review</option>
                <option value="KYC Incomplete">KYC Incomplete</option>
            </select>
            <select id="kycFilterSelect" class="fg-filter-select" aria-label="Filter by KYC Status">
                <option value="">All KYC Statuses</option>
                <option value="Verified">Verified</option>
                <option value="Pending">Pending</option>
                <option value="Failed">Failed</option>
            </select>
        </div>
    </div>

    <!-- Responsive Table -->
    <div class="fg-table-responsive">
        <table class="fg-table" id="customerTable">
            <thead>
                <tr>
                    <th scope="col" style="width: 100px;">Customer ID</th>
                    <th scope="col">Borrower Name</th>
                    <th scope="col">Contact Info</th>
                    <th scope="col" class="text-end">Monthly Income</th>
                    <th scope="col" class="text-center">Credit Status</th>
                    <th scope="col" class="text-center">KYC Status</th>
                    <th scope="col" class="text-end" style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="customer-row"
                            data-search="@item.CustomerId @item.Name.ToLower() @item.Email.ToLower() @item.Phone"
                            data-credit="@item.CreditStatus"
                            data-kyc="@item.KycStatus">
                            <td>
                                <span class="fg-row-id">#@item.CustomerId</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.Name</div>
                                <div class="text-muted small">@item.Email</div>
                            </td>
                            <td>
                                <div class="num-tabular text-secondary">
                                    <span class="text-muted me-1">@item.CountryCode</span>@item.Phone
                                </div>
                            </td>
                            <td class="text-end num-tabular fw-semibold text-dark">
                                ₹@item.MonthlyIncome.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (item.CreditStatus == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-circle-check me-1"></i> Active Loan
                                    </span>
                                }
                                else if (item.CreditStatus == "Eligible")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-shield-check me-1"></i> Eligible
                                    </span>
                                }
                                else if (item.CreditStatus == "Under Review")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-clock me-1"></i> Under Review
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-user-clock me-1"></i> KYC Incomplete
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.KycStatus == "Verified")
                                {
                                    <span class="fg-badge fg-badge-success">
                                        <span class="fg-badge-dot"></span>
                                        Verified
                                    </span>
                                }
                                else if (item.KycStatus == "Failed")
                                {
                                    <span class="fg-badge fg-badge-danger">
                                        <span class="fg-badge-dot"></span>
                                        Failed
                                    </span>
                                }
                                else
                                {
                                    <span class="fg-badge fg-badge-warning">
                                        <span class="fg-badge-dot"></span>
                                        Pending
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId"
                                       class="fg-btn fg-btn-secondary fg-btn-sm" title="Edit Profile">
                                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                        <span>Edit</span>
                                    </a>


                                    <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline m-0"
                                          onsubmit="return confirm('Are you sure you want to delete customer #@item.CustomerId (@item.Name)? Active loans must be cleared first.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="fg-btn fg-btn-danger fg-btn-sm" title="Delete customer">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="p-0">
                            <div class="fg-empty-state">
                                <div class="fg-empty-icon">
                                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                                </div>
                                <h3 class="fg-empty-title">No Customers Registered</h3>
                                <p class="fg-empty-desc">Your customer directory is empty. Onboard your first borrower to evaluate credit and issue loans.</p>
                                <a asp-action="Create" class="fg-btn fg-btn-primary fg-btn-sm">
                                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                    <span>Onboard Customer</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side instant filter and search
        (function () {
            const searchInput = document.getElementById('customerSearchInput');
            const creditFilter = document.getElementById('statusFilterSelect');
            const kycFilter = document.getElementById('kycFilterSelect');
            const rows = document.querySelectorAll('.customer-row');

            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
                const creditVal = creditFilter ? creditFilter.value : '';
                const kycVal = kycFilter ? kycFilter.value : '';

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    const rowCredit = row.getAttribute('data-credit') || '';
                    const rowKyc = row.getAttribute('data-kyc') || '';

                    const matchesQuery = !query || searchData.includes(query);
                    const matchesCredit = !creditVal || rowCredit === creditVal;
                    const matchesKyc = !kycVal || rowKyc === kycVal;

                    if (matchesQuery && matchesCredit && matchesKyc) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (creditFilter) creditFilter.addEventListener('change', applyFilters);
            if (kycFilter) kycFilter.addEventListener('change', applyFilters);

            // Auto-hide alert boxes smoothly after 4 seconds
            ['alertBoxSuccess', 'alertBoxError', 'alertBoxErrorMessage'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    setTimeout(() => {
                        el.style.transition = 'opacity 400ms ease';
                        el.style.opacity = '0';
                        setTimeout(() => el.remove(), 400);
                    }, 4000);
                }
            });
        })();
    </script>
}