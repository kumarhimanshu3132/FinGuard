@model FinGuard.Models.Customer

@{
    ViewData["Title"] = "Verify Identity";
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
        margin-top: 1rem;
    }

    .header-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    .kyc-card {
        background-color: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        padding: 40px 50px;
        color: #ffffff;
        max-width: 600px;
        margin: 0 auto;
    }

    .kyc-card h3 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .kyc-card p.subtitle {
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        font-weight: 600;
        font-size: 14px;
        color: #cbd5e1;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        background-color: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border-radius: 10px;
        padding: 12px 15px;
    }
    
    .form-control::placeholder {
        color: #64748b;
    }

    .form-control:focus {
        background-color: rgba(15, 23, 42, 0.9);
        border-color: #6366f1;
        color: #ffffff;
        box-shadow: none;
        outline: none;
    }

    .btn-send-otp {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        padding: 14px;
        width: 100%;
        margin-top: 15px;
        transition: opacity 0.2s, transform 0.1s;
    }

    .btn-send-otp:hover {
        opacity: 0.9;
    }

    .btn-send-otp:active {
        transform: scale(0.98);
    }
</style>

<div class="page-header text-center">
    <h2 class="header-title" style="color: var(--text-primary);">KYC Verification</h2>
</div>

<div class="kyc-card">
    <h3 class="text-center">Verify Identity</h3>
    <p class="text-center subtitle">Provide identity details for @Model.Name</p>

    <form asp-action="VerifyIdentity" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CustomerId" />

        @if (!ViewData.ModelState.IsValid || ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 mb-3 rounded" style="font-size:14px;">
                @if (ViewBag.Error != null)
                {
                    <p class="mb-0">@ViewBag.Error</p>
                }
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <div class="form-group">
            <label>PAN Number</label>
            <input type="text" name="pan" class="form-control" placeholder="Enter 10-digit PAN (e.g. ABCDE1234F)" required />
        </div>

        <div class="form-group">
            <label>Identity Document (Aadhaar/Passport)</label>
            <input type="text" name="idDocument" class="form-control" placeholder="Enter Document ID" required />
        </div>

        <div class="form-group">
            <label>OTP Verification</label>
            <input type="text" name="otp" class="form-control" placeholder="Enter the OTP received" required />
            <small class="text-muted d-block mt-1">An OTP was sent to your registered contact.</small>
        </div>

        <button type="submit" class="btn-send-otp">Verify & Complete KYC</button>
    </form>
</div>
