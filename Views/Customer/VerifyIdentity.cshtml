@model FinGuard.Models.Customer

@{
    ViewData["Title"] = "KYC Verification";
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-id-card text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Identity & KYC Compliance Verification
        </h1>
        <p class="fg-page-subtitle">Demographic validation for borrower #@Model.CustomerId (@Model.Name).</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to Directory</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="fg-card">
            <div class="d-flex align-items-center gap-3 p-3 bg-light border rounded-3 mb-4">
                <div class="fg-brand-icon" style="background-color: var(--fg-primary);">
                    <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark">@Model.Name</div>
                    <div class="text-muted small">DOB: @Model.DateOfBirth.ToString("yyyy-MM-dd") | PIN: @Model.PinCode</div>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid || ViewBag.Error != null)
            {
                <div class="fg-alert fg-alert-danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation fg-alert-icon" aria-hidden="true"></i>
                    <div class="fg-alert-content">
                        @if (ViewBag.Error != null)
                        {
                            <div>@ViewBag.Error</div>
                        }
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                </div>
            }

            <form asp-action="VerifyIdentity" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustomerId" />

                <div class="mb-3">
                    <label class="fg-form-label" for="panInput">
                        Permanent Account Number (PAN) <span class="required text-danger">*</span>
                    </label>
                    <input type="text" id="panInput" name="pan" class="form-control text-uppercase"
                           placeholder="ABCDE1234F" maxlength="10" required />
                    <div class="fg-input-hint">10-character alphanumeric PAN format.</div>
                </div>

                <div class="mb-3">
                    <label class="fg-form-label" for="idDocInput">
                        Identity Document Number (Aadhaar / Voter ID) <span class="required text-danger">*</span>
                    </label>
                    <input type="text" id="idDocInput" name="idDocument" class="form-control"
                           placeholder="Enter official document ID" required />
                    <div class="fg-input-hint">Encrypted upon storage for borrower privacy.</div>
                </div>

                <div class="mb-4">
                    <label class="fg-form-label" for="otpInput">
                        Verification OTP Code <span class="required text-danger">*</span>
                    </label>
                    <input type="text" id="otpInput" name="otp" class="form-control num-tabular"
                           placeholder="Enter 6-digit OTP code" maxlength="6" required />
                    <div class="fg-input-hint">Sent to registered email (@Model.Email). Demo bypass: 000000 or 123456.</div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-2">
                    <a asp-action="Index" class="fg-btn fg-btn-secondary">Cancel</a>
                    <button type="submit" class="fg-btn fg-btn-primary">
                        <i class="fa-solid fa-shield-check" aria-hidden="true"></i>
                        <span>Verify & Approve KYC</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
