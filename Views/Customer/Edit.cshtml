@model FinGuard.Models.Customer

@{
    ViewData["Title"] = "Edit Borrower Profile";
    string maxDate = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd");
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-pen-to-square text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Edit Borrower Profile #@Model.CustomerId
        </h1>
        <p class="fg-page-subtitle">Update contact information, address details, or monthly declared income.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to Directory</span>
        </a>
    </div>
</div>

@if (ViewBag.SuccessMessage != null)
{
    <div id="alertBox" class="fg-alert fg-alert-success" role="alert">
        <i class="fa-solid fa-circle-check fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@ViewBag.SuccessMessage</div>
    </div>
}

@if (ViewBag.InfoMessage != null)
{
    <div id="alertBox" class="fg-alert fg-alert-info" role="alert">
        <i class="fa-solid fa-circle-info fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@ViewBag.InfoMessage</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="fg-card">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="CreditStatus" />

                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">Personal & Contact Credentials</h2>
                    <p class="fg-form-section-desc">Borrower account identity information.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="fg-form-label">
                                Full Legal Name <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control"
                                   oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '').replace(/\s{2,}/g, ' ');"
                                   required />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="fg-form-label">
                                Email Address <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control" required />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="CountryCode" class="fg-form-label">Country Code</label>
                            <input asp-for="CountryCode" class="form-control" required />
                            <span asp-validation-for="CountryCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Phone" class="fg-form-label">
                                Phone Number <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="Phone" class="form-control num-tabular"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />
                            <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="fg-form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" max="@maxDate" class="form-control" required />
                            <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">Financial Details & Residential Address</h2>
                    <p class="fg-form-section-desc">Updated income benchmark and permanent address.</p>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="MonthlyIncome" class="fg-form-label">
                                Monthly Income (₹) <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="MonthlyIncome" type="number" step="0.01" min="1"
                                   class="form-control num-tabular" required />
                            <span asp-validation-for="MonthlyIncome" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Address" class="fg-form-label">
                                Complete Residential Address <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="Address" class="form-control" required />
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="PinCode" class="fg-form-label">
                                Postal PIN Code <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="PinCode" class="form-control num-tabular"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);" required />
                            <span asp-validation-for="PinCode" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-3">
                    <a asp-action="Index" class="fg-btn fg-btn-secondary">Cancel</a>
                    <button type="submit" class="fg-btn fg-btn-primary">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const alertBox = document.getElementById('alertBox');
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = 'opacity 400ms ease';
                    alertBox.style.opacity = '0';
                    setTimeout(() => alertBox.remove(), 400);
                }, 3500);
            }
        })();
    </script>
}