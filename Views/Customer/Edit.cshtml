@model FinGuard.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
    string maxDate = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd");
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
        margin-top: 1rem;
    }

    .header-title {
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .bg-dark-card {
        background-color: #111827;
        border-radius: 1rem;
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5);
        border: 1px solid #374151;
        padding: 2rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        border-radius: 12px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border: none;
        box-shadow: 0 8px 16px -4px rgba(99, 102, 241, 0.3);
        transition: all 0.3s ease;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -4px rgba(99, 102, 241, 0.5);
        color: white;
    }

    .btn-back {
        background: transparent;
        color: #94a3b8;
        border: 1px solid #475569;
        border-radius: 12px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.05);
        color: #f8fafc;
        border-color: #64748b;
    }

    .form-control,
    .form-select {
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid #374151;
        background-color: #1e293b;
        color: #f3f4f6;
        transition: all 0.2s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
        background-color: #1e293b;
        color: #f3f4f6;
        outline: none;
    }

    .form-control::placeholder {
        color: #64748b;
    }

    .form-label {
        font-weight: 500;
        color: #94a3b8;
        margin-bottom: 0.25rem;
        font-size: 0.875rem;
    }
</style>

<div class="page-header text-center">
    <h2 class="header-title mb-0">Edit Customer Profile</h2>
</div>

@if (ViewBag.SuccessMessage != null)
{
    <div id="alertBox" class="alert alert-success d-flex align-items-center mx-auto"
         style="max-width: 800px; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; transition: opacity 0.5s ease;">
        <span class="me-2">✅</span> @ViewBag.SuccessMessage
    </div>
}

@if (ViewBag.InfoMessage != null)
{
    <div id="alertBox" class="alert alert-info d-flex align-items-center mx-auto"
         style="max-width: 800px; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; transition: opacity 0.5s ease;">
        <span class="me-2">ℹ️</span> @ViewBag.InfoMessage
    </div>
}

<script>
    setTimeout(function () {
        var alertBox = document.getElementById('alertBox');
        if (alertBox) {
            alertBox.style.opacity = '0';
            setTimeout(function () {
                alertBox.style.display = 'none';
            }, 500);
        }
    }, 3000);
</script>

<div class="bg-dark-card mx-auto" style="max-width: 800px;">
    <form asp-action="Edit">
        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="CreditStatus" />

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label text-slate-400 small fw-medium mb-1">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter full name"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '').replace(/\s{2,}/g, ' ');"
                       required />
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label text-slate-400 small fw-medium mb-1">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your e-mail" required />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CountryCode" class="form-label text-slate-400 small fw-medium mb-1">Country Code</label>
                <input asp-for="CountryCode" class="form-control" placeholder="+91" required />
                <span asp-validation-for="CountryCode" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Phone" class="form-label text-slate-400 small fw-medium mb-1">Phone Number</label>
                <input asp-for="Phone" class="form-control" placeholder="Enter 10-digit phone number"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />
                <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label text-slate-400 small fw-medium mb-1">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" max="@maxDate" class="form-control" required />
                <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="MonthlyIncome" class="form-label text-slate-400 small fw-medium mb-1">Monthly Income (₹)</label>
                <input asp-for="MonthlyIncome" type="number" step="0.01" min="1" class="form-control"
                       placeholder="Enter monthly income" required />
                <span asp-validation-for="MonthlyIncome" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label text-slate-400 small fw-medium mb-1">Complete Address</label>
                <textarea asp-for="Address" class="form-control" rows="3"
                          placeholder="Enter complete residential address" required></textarea>
                <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PinCode" class="form-label text-slate-400 small fw-medium mb-1">PIN Code</label>
                <input asp-for="PinCode" class="form-control" placeholder="Enter 6-digit PIN code"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);" required />
                <span asp-validation-for="PinCode" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12 mt-5 d-flex gap-3 justify-content-center">
                <button type="submit" class="btn-save">Save Changes</button>
                <a asp-action="Index" class="btn-back">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}