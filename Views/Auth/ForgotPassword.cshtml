@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinGuard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-image: radial-gradient(circle at top right, rgba(99, 102, 241, 0.1), transparent 40%),
                              radial-gradient(circle at bottom left, rgba(99, 102, 241, 0.1), transparent 40%);
        }
        .fg-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 40px 50px;
            width: 100%;
            max-width: 450px;
            text-align: center;
        }
        h1 { font-weight: 800; color: #0f172a; margin-bottom: 10px; font-size: 24px; }
        p { color: #64748b; font-size: 14px; margin-bottom: 25px; line-height: 1.5; }
        input {
            background-color: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 15px;
            margin-bottom: 15px;
            width: 100%;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: #6366f1; background-color: #ffffff; }
        button {
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            padding: 12px;
            width: 100%;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        button:hover { opacity: 0.9; }
        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }
        .alert-success { background: #dcfce7; color: #166534; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 600; }
    </style>
</head>
<body>
    <div class="fg-card">
        <h1>Password Reset</h1>
        <p>Enter your registered email address and we'll send you a link to securely reset your password.</p>
        
        @if (ViewBag.Success != null)
        {
            <div class="alert-success">@ViewBag.Success</div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="email" name="email" placeholder="Email Address" required />
                <button type="submit">Send Reset Link</button>
            </form>
        }
        
        <a asp-action="Login" class="back-link">← Back to Login</a>
    </div>
</body>
</html>
