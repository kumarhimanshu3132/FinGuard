@{
    ViewData["Title"] = "Account Setup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - FinGuard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #f8fafc;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
            }

            .auth-card {
                background: #ffffff;
                border-radius: 24px;
                box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
                padding: 3rem;
                width: 100%;
                max-width: 450px;
            }

            .modern-input {
                border-radius: 12px;
                border: 2px solid #e2e8f0;
                padding: 0.8rem 1.2rem;
                width: 100%;
            }

            .btn-submit {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: white;
                border-radius: 12px;
                padding: 1rem;
                width: 100%;
                font-weight: bold;
                border: none;
            }
    </style>
</head>

<body>
    <div class="auth-card">
        <h3 class="text-center fw-bold mb-1">Verify Email</h3>
        <p class="text-muted text-center mb-4">We will send a 6-digit OTP to your registered email.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center rounded-3">@ViewBag.Error</div>
        }

        <form asp-action="SendOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="email" name="email" class="modern-input mb-3" placeholder="Enter your whitelisted Email"
                   required />
            <button type="submit" class="btn-submit">Send OTP</button>
        </form>

        <div class="text-center mt-4">
            <a asp-action="Login" class="text-decoration-none text-secondary">Back to Login</a>
        </div>
    </div>
</body>

</html>