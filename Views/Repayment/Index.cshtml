@model IEnumerable<FinGuard.Models.Loan>

@{
    ViewData["Title"] = "EMI Collections";
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
        margin-top: 1rem;
    }

    .header-title {
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
        color: var(--text-primary);
    }

    .custom-table th {
        background: rgba(0, 0, 0, 0.2);
        color: var(--text-primary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .custom-table td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        color: var(--text-primary);
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center" style="max-width: 1000px; margin: 1rem auto 2.5rem;">
    <h2 class="header-title mb-0">EMI Collections</h2>
</div>

@if (TempData["Success"] != null)
{
    <div id="alertBoxSuccess" class="alert alert-success d-flex align-items-center"
         style="max-width: 1000px; margin: 0 auto 1.5rem; border-radius: 12px; font-weight: 600; transition: opacity 0.5s ease;">
        <span class="me-2">✅</span> @TempData["Success"]
    </div>

    <script>
        setTimeout(function () {
            var successBox = document.getElementById('alertBoxSuccess');
            if (successBox) {
                successBox.style.opacity = '0';
                setTimeout(function () { successBox.style.display = 'none'; }, 500);
            }
        }, 3000);
    </script>
}

<div class="fg-card" style="max-width: 1000px; margin: 0 auto; padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th class="text-light">Loan ID</th>
                    <th class="text-light">Customer ID</th>
                    <th class="text-light">Monthly EMI</th>
                    <th class="text-light">Remaining Balance</th>
                    <th class="text-light">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-light">#@item.LoanId</td>
                            <td class="text-light opacity-75">#@item.CustomerId</td>
                            <td class="fw-bold text-light">₹@item.EMIAmount</td>
                            <td class="fw-bold text-danger">₹@item.RemainingBalance</td>
                            <td>
                                <a asp-controller="Repayment" asp-action="Collect" asp-route-loanId="@item.LoanId"
                                   class="btn btn-sm px-4 fw-bold text-white rounded-pill"
                                   style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">Collect EMI</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <h5 class="fw-bold text-light opacity-75">No active loans found for collection.</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>