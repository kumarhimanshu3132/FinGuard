@model FinGuard.Models.Repayment

@{
    ViewData["Title"] = $"Collection Receipt #REC-{Model.RepaymentId}";
    var customer = ViewBag.Customer as FinGuard.Models.Customer;
    var loan = Model.Loan;
}

<!-- Page Header -->
<div class="fg-page-header d-print-none">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-receipt text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Installment Collection Receipt
            <span class="fg-count-badge">#REC-@Model.RepaymentId</span>
        </h1>
        <p class="fg-page-subtitle">Official microfinance collection acknowledgment and balance deduction record.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" onclick="window.print()" class="fg-btn fg-btn-primary fg-btn-sm">
            <i class="fa-solid fa-print me-1"></i> Print Receipt
        </button>
        <a asp-action="History" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> Repayment History
        </a>
        <a asp-action="Index" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Collections
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="fg-alert fg-alert-success mb-3 d-print-none" role="alert">
        <i class="fa-solid fa-circle-check fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Success"]</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="fg-card p-4 p-md-5 shadow-sm border" id="printableReceiptArea">
            <!-- Institutional Header -->
            <div class="d-flex justify-content-between align-items-start pb-4 mb-4 border-bottom">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 1.1rem;">
                            FG
                        </div>
                        <div>
                            <h2 class="fs-5 fw-bold text-dark mb-0">FinGuard Microfinance</h2>
                            <span class="text-secondary small">Operations & Loan Recovery Division</span>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        Institutional RBI Compliant Lending &bull; Regulated NBFC Operations
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-2 d-inline-block fw-semibold">
                        <i class="fa-solid fa-circle-check me-1"></i> SETTLED & VERIFIED
                    </span>
                    <div class="fw-bold text-dark fs-6 font-monospace">VOUCHER #REC-@Model.RepaymentId</div>
                    <div class="text-muted small">@Model.PaymentDate.ToString("dd MMMM yyyy, hh:mm tt") UTC</div>
                </div>
            </div>

            <!-- Transaction Particulars Grid -->
            <div class="row g-3 mb-4 text-start">
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Borrower Customer:</span>
                    <strong class="text-dark fs-6 d-block">@(customer?.Name ?? "Customer #" + (loan?.CustomerId ?? 0))</strong>
                    <span class="text-muted small">Customer ID: #@(customer?.CustomerId ?? loan?.CustomerId)</span>
                    @if (!string.IsNullOrEmpty(customer?.Phone))
                    {
                        <span class="text-muted small d-block">Phone: @customer.Phone</span>
                    }
                </div>

                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Loan Facility Account:</span>
                    <strong class="text-dark fs-6 d-block">#LN-@Model.LoanId</strong>
                    <span class="text-muted small">Original Principal: ₹@(loan?.PrincipalAmount.ToString("N2") ?? "0.00")</span>
                    <span class="text-muted small d-block">Scheduled Monthly EMI: ₹@(loan?.EMIAmount.ToString("N2") ?? "0.00")</span>
                </div>

                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Collection Channel / Mode:</span>
                    <strong class="text-dark d-block">@(string.IsNullOrEmpty(Model.PaymentMethod) ? "Field Collection" : Model.PaymentMethod)</strong>
                    <span class="text-muted small">Recorded By: @Model.CollectedBy</span>
                </div>

                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Transaction Reference:</span>
                    <strong class="text-dark font-monospace d-block">@(string.IsNullOrEmpty(Model.TransactionReference) ? $"REC_{Model.RepaymentId}_{Model.LoanId}" : Model.TransactionReference)</strong>
                    @if (!string.IsNullOrEmpty(Model.BankReference))
                    {
                        <span class="text-muted font-monospace small d-block">Bank Auth: @Model.BankReference</span>
                    }
                </div>
            </div>

            <!-- Amount Highlight Box -->
            <div class="p-4 bg-light rounded-3 border text-center mb-4">
                <div class="text-secondary small fw-bold text-uppercase letter-spacing mb-1">
                    Installment Amount Collected & Credited
                </div>
                <div class="display-6 fw-bold text-success num-tabular mb-1">
                    ₹@Model.AmountPaid.ToString("N2")
                </div>
                <div class="text-muted small">
                    Amount credited to loan principal and scheduled installment ledger.
                </div>
            </div>

            <!-- Loan Account Post-Transaction Status -->
            <div class="row g-3 p-3 bg-light border rounded-3 mb-4 text-start">
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Updated Remaining Balance:</span>
                    <strong class="fs-6 num-tabular @(loan?.RemainingBalance <= 0 ? "text-success" : "text-danger")">
                        ₹@(loan?.RemainingBalance.ToString("N2") ?? "0.00")
                    </strong>
                    @if (loan?.RemainingBalance <= 0)
                    {
                        <span class="badge bg-success text-white small ms-1">LOAN CLOSED</span>
                    }
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Next Scheduled Installment Due:</span>
                    <strong class="text-dark">
                        @(loan?.RemainingBalance <= 0 ? "No Further Dues (Settled)" : loan?.NextDueDate.ToString("dd MMMM yyyy"))
                    </strong>
                </div>
            </div>

            <!-- Institutional Disclaimer Footer -->
            <div class="pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
                <div>
                    <div>FinGuard Microfinance Core Operations</div>
                    <div style="font-size: 0.72rem;">Computer-generated official receipt voucher. Signature not required.</div>
                </div>
                <div class="text-end">
                    <div class="font-monospace" style="font-size: 0.72rem;">STATUS: SUCCESS (CONFIRMED)</div>
                    <div style="font-size: 0.72rem;">System Timestamp: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                </div>
            </div>
        </div>
    </div>
</div>
