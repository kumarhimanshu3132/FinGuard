@model FinGuard.Models.Repayment
@{
    ViewData["Title"] = "Collect EMI";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h4 class="fw-bold mb-4 text-dark">Collect Payment</h4>

            <div class="alert alert-info rounded-3 mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold">Loan ID:</span>
                    <span class="fw-bold">#@Model.LoanId</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">Current Remaining Balance:</span>
                    <span class="fw-bold text-danger">₹@ViewBag.RemainingBalance</span>
                </div>
            </div>

            <form asp-action="Collect" method="post">
                <input type="hidden" asp-for="LoanId" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Amount to Collect (₹)</label>
                    <input asp-for="AmountPaid" class="form-control form-control-lg rounded-3" required />
                    <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-success flex-grow-1 py-2 fw-bold rounded-pill"
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border:none;">
                        Confirm Payment
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 fw-bold rounded-pill border">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}