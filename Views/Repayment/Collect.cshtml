@model FinGuard.Models.Repayment

@{
    ViewData["Title"] = "Collect Installment";
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-receipt text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Record EMI Collection Voucher
        </h1>
        <p class="fg-page-subtitle">Submit installment receipt for Loan Account #@Model.LoanId.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to Collections</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="fg-card">
            <!-- Account Summary Card -->
            <div class="p-3 bg-light border rounded-3 mb-4">
                @{
                    var customer = ViewBag.Customer as FinGuard.Models.Customer;
                    decimal emiAmount = ViewBag.EMIAmount is decimal e ? e : 0;
                    decimal maxCollect = ViewBag.MaxCollectable is decimal m ? m : emiAmount;
                }
                @if (customer != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-secondary small fw-medium">Borrower Customer:</span>
                        <div class="text-end">
                            <span class="fw-bold text-dark d-block">@customer.Name</span>
                            <span class="text-muted small">Customer ID: #@customer.CustomerId</span>
                        </div>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-medium">Loan Account Number:</span>
                    <span class="fg-row-id fs-6">#@Model.LoanId</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-medium">Original Principal:</span>
                    <span class="num-tabular fw-semibold text-dark">₹@((ViewBag.Principal is decimal p) ? p.ToString("N2") : ViewBag.Principal)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-medium">Scheduled Monthly EMI:</span>
                    <strong class="num-tabular text-primary fs-6">₹@emiAmount.ToString("N2")</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="text-secondary small fw-medium">Remaining Outstanding Balance:</span>
                    <strong class="num-tabular text-danger fs-6">₹@((ViewBag.RemainingBalance is decimal r) ? r.ToString("N2") : ViewBag.RemainingBalance)</strong>
                </div>
            </div>

            <form asp-action="Collect" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LoanId" />

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="AmountPaid" class="fg-form-label mb-0">
                            Amount to Collect (₹) <span class="required text-danger">*</span>
                        </label>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                            Max Allowed: ₹@maxCollect.ToString("N2")
                        </span>
                    </div>
                    <input asp-for="AmountPaid" type="number" step="0.01" min="1" max="@maxCollect" id="amountPaidInput"
                           class="form-control form-control-lg num-tabular fw-bold text-dark"
                           value="@maxCollect.ToString("F2")"
                           placeholder="Enter collection amount" required />
                    <span asp-validation-for="AmountPaid" class="text-danger small mt-1 d-block"></span>
                    <div id="overCollectionAlert" class="alert alert-danger py-2 px-3 small mt-2 d-none">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        Over-collection is strictly prohibited. Single collection cannot exceed the scheduled monthly installment of ₹@maxCollect.ToString("N2").
                    </div>
                    <div class="fg-input-hint mt-1 text-muted small">
                        <i class="fa-solid fa-circle-info text-primary me-1"></i>
                        FinGuard policy enforces exactly 1 monthly installment (₹@emiAmount.ToString("N2")) per collection transaction.
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-2">
                    <a asp-action="Index" class="fg-btn fg-btn-secondary">Cancel</a>
                    <button type="submit" id="btnSubmitCollect" class="fg-btn fg-btn-success">
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        <span>Confirm Receipt & Deduct Balance</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const maxVal = parseFloat('@maxCollect') || 0;
            const input = document.getElementById('amountPaidInput');
            const alertBox = document.getElementById('overCollectionAlert');
            const submitBtn = document.getElementById('btnSubmitCollect');

            function validate() {
                const val = parseFloat(input.value) || 0;
                if (val > maxVal) {
                    alertBox.classList.remove('d-none');
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-50');
                } else if (val <= 0) {
                    alertBox.classList.add('d-none');
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-50');
                } else {
                    alertBox.classList.add('d-none');
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-50');
                }
            }

            input.addEventListener('input', validate);
            input.addEventListener('change', validate);
            validate();
        });
    </script>
}