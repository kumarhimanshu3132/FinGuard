@{
    ViewData["Title"] = "Digital Microfinance Lending";
    Layout = "_BorrowerLayout";
}

<!-- Hero Section -->
<div class="row align-items-center py-5 g-5">
    <div class="col-lg-7">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white border rounded-pill shadow-xs mb-3">
            <span class="badge bg-success rounded-pill px-2">Institutional Microfinance</span>
            <span class="text-secondary small fw-medium">Fair, Transparent, Community-Driven Credit</span>
        </div>
        <h1 class="display-5 fw-bold text-dark lh-tight mb-3">
            Empowering Livelihoods Through Responsible Digital Lending
        </h1>
        <p class="fs-5 text-secondary mb-4 lh-base" style="max-width: 600px;">
            FinGuard provides community-backed microfinance loans designed for self-help groups, micro-enterprises, and working capital needs. Track every installment, schedule, and verified receipt in real time.
        </p>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-lg">
                <i class="fa-solid fa-hand-holding-dollar me-1" aria-hidden="true"></i> Apply for a Loan
            </a>
            <a asp-controller="BorrowerAuth" asp-action="Login" class="bp-btn bp-btn-secondary bp-btn-lg">
                <i class="fa-solid fa-arrow-right-to-bracket me-1" aria-hidden="true"></i> Sign In
            </a>
            <a asp-controller="BorrowerAuth" asp-action="Register" class="bp-btn bp-btn-outline bp-btn-lg text-decoration-none">
                <i class="fa-solid fa-user-plus me-1 text-indigo"></i> Create Account
            </a>
        </div>

        <div class="row mt-5 pt-3 border-top g-4">
            <div class="col-sm-4">
                <div class="fs-4 fw-bold text-dark num-tabular">₹5K - ₹200K</div>
                <div class="text-secondary small">Flexible Capital Range</div>
            </div>
            <div class="col-sm-4">
                <div class="fs-4 fw-bold text-dark num-tabular">12% p.a.</div>
                <div class="text-secondary small">Capped Transparent APR</div>
            </div>
            <div class="col-sm-4">
                <div class="fs-4 fw-bold text-dark num-tabular">3 - 36 Mos</div>
                <div class="text-secondary small">Customized Repayment Tenures</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="bp-card p-4 shadow-md bg-white border">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <span class="small text-secondary fw-semibold text-uppercase">Loan Estimator</span>
                <span class="bp-badge bp-badge-success"><span class="bp-badge-dot"></span> 12.0% Fixed Rate</span>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Estimated Loan Capital</label>
                <div class="fs-3 fw-bold text-dark num-tabular mb-1" id="bpDispPrincipal">₹30,000.00</div>
                <input type="range" class="form-range" id="bpReqPrincipal" min="5000" max="200000" step="5000" value="30000" />
                <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                    <span>₹5,000</span>
                    <span>₹2,00,000</span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Repayment Duration</label>
                <select class="form-select" id="bpReqTenure">
                    <option value="6">6 Months</option>
                    <option value="12" selected>12 Months (Recommended)</option>
                    <option value="18">18 Months</option>
                    <option value="24">24 Months</option>
                    <option value="36">36 Months</option>
                </select>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary small">Estimated Monthly Installment:</span>
                    <strong class="text-indigo num-tabular fs-5" id="bpDispEmi">₹2,665.46</strong>
                </div>
                <div class="d-flex justify-content-between pt-2 border-top">
                    <span class="text-secondary small">Total Repayment Over Tenure:</span>
                    <strong class="text-dark num-tabular" id="bpDispTotal">₹31,985.52</strong>
                </div>
            </div>

            <a asp-action="Apply" class="bp-btn bp-btn-primary w-100 py-2 fs-6">
                Start Loan Application <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
            <div class="text-center text-muted mt-2" style="font-size: 0.75rem;">
                No pre-closure penalty • Subject to KYC & center appraisal
            </div>
        </div>
    </div>
</div>

<!-- 4-Step Journey Section -->
<div class="py-5 border-top">
    <div class="text-center mb-5">
        <h2 class="fs-3 fw-bold text-dark mb-2">How FinGuard Microfinance Works</h2>
        <p class="text-secondary small mb-0" style="max-width: 540px; margin: 0 auto;">
            A structured, human-centric lending cycle adhering to fair practices and group center support.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="bp-card h-100 p-4">
                <div class="bp-kpi-icon indigo mb-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                    <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-2">1. Profile Registration</h3>
                <p class="text-secondary small mb-0">Register with basic identity details, date of birth, and contact numbers. Instant email and mobile confirmation.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bp-card h-100 p-4">
                <div class="bp-kpi-icon success mb-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-2">2. Term Selection</h3>
                <p class="text-secondary small mb-0">Choose your desired principal and duration. Clear mathematical EMI estimation with no hidden charges.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bp-card h-100 p-4">
                <div class="bp-kpi-icon warning mb-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                    <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-2">3. Field Appraisal</h3>
                <p class="text-secondary small mb-0">A certified operations officer conducts household verification and Self-Help Group (SHG) peer appraisal.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bp-card h-100 p-4">
                <div class="bp-kpi-icon indigo mb-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                    <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-2">4. Verified Receipts</h3>
                <p class="text-secondary small mb-0">Disbursement into designated bank account. Every center collection installment generates a digital receipt.</p>
            </div>
        </div>
    </div>
</div>

<!-- FAQs -->
<div class="py-5 border-top">
    <div class="text-center mb-5">
        <h2 class="fs-3 fw-bold text-dark mb-2">Frequently Asked Questions</h2>
        <p class="text-secondary small mb-0">Clear answers on interest rules, repayment methods, and borrower rights.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="faqHeading1">
                        <button class="accordion-button fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1">
                            Who is eligible for FinGuard microfinance loans?
                        </button>
                    </h2>
                    <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary small">
                            Borrowers must be at least 18 years of age, possess a valid government identity document (such as Aadhaar or Voter Card), and maintain verifiable household or micro-enterprise income. Membership in a local Self-Help Group or joint-liability peer group is preferred.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="faqHeading2">
                        <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
                            How are installments collected and recorded?
                        </button>
                    </h2>
                    <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary small">
                            Installments are collected during scheduled monthly center meetings by authorized field officers or at regional branch collection counters. Each transaction is digitally timestamped, and a genuine receipt voucher is instantly logged into your borrower portal.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="faqHeading3">
                        <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
                            Can a borrower take multiple loans simultaneously?
                        </button>
                    </h2>
                    <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-secondary small">
                            To prevent household over-indebtedness, FinGuard policy permits only one active microfinance loan per borrower at any given time. Once a loan is fully recovered and marked 'Closed', borrowers are eligible for higher-tier capital limits.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
