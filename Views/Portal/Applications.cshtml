@model List<FinGuard.Models.Loan>

@{
    ViewData["Title"] = "My Loan Requests";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h1 class="fs-5 fw-bold text-dark mb-0">Loan Requests & Status</h1>
            <p class="text-secondary small mb-0">Track application underwriting, approvals, rejection reasons, and disbursement particulars.</p>
        </div>
        <div>
            <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-sm py-1 px-3">
                <i class="fa-solid fa-plus me-1"></i> Apply for New Loan
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3 mb-3 rounded-3 small border-success-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var app in Model)
            {
                var disb = app.Disbursements?.FirstOrDefault();
                var bank = disb?.BankAccount;
                bool isApproved = app.Status == "Active" || app.Status == "Approved";
                bool isPending = app.Status == "Pending";
                bool isRejected = app.Status == "Rejected";

                <div class="col-12">
                    <div class="bp-card p-4 border shadow-sm @(isApproved ? "border-success-subtle" : (isRejected ? "border-danger-subtle" : "border-warning-subtle"))">
                        <!-- Top Header with ID and Status Badge -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-3 mb-3 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">#APP-@app.LoanId</span>
                                <span class="text-muted small">Submitted for Microfinance Facility</span>
                            </div>

                            <div>
                                @if (isApproved)
                                {
                                    <span class="bp-badge bp-badge-success fs-6 px-3 py-1">
                                        <i class="fa-solid fa-circle-check me-1"></i> Accepted & Disbursed
                                    </span>
                                }
                                else if (isPending)
                                {
                                    <span class="bp-badge bp-badge-warning fs-6 px-3 py-1">
                                        <i class="fa-solid fa-clock me-1"></i> Under Review
                                    </span>
                                }
                                else if (isRejected)
                                {
                                    <span class="bp-badge bp-badge-danger fs-6 px-3 py-1">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Application Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="bp-badge bp-badge-neutral fs-6 px-3 py-1">
                                        @app.Status
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Loan Terms & Destination Bank Details -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6 col-md-3">
                                <div class="text-secondary small">Requested Principal:</div>
                                <div class="fs-5 fw-bold text-dark num-tabular">₹@app.PrincipalAmount.ToString("N2")</div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="text-secondary small">Repayment Duration:</div>
                                <div class="fs-6 fw-bold text-dark">@app.TenureMonths Months (@app.InterestRate% APR)</div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="text-secondary small">Monthly EMI:</div>
                                <div class="fs-5 fw-bold text-indigo num-tabular">₹@app.EMIAmount.ToString("N2")</div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="text-secondary small">Designated Bank Account:</div>
                                @if (bank != null)
                                {
                                    <div class="fw-bold text-dark text-truncate" title="@bank.BankName (@bank.MaskedAccountNumber)">
                                        <i class="fa-solid fa-building-columns text-primary me-1"></i> @bank.BankName
                                    </div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        A/C: @bank.MaskedAccountNumber &bull; IFSC: @bank.IFSCCode
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small">Standard Primary Account</div>
                                }
                            </div>
                        </div>

                        <!-- Status Alert / Feedback Block -->
                        @if (isApproved)
                        {
                            <div class="p-3 bg-success-subtle border border-success-subtle rounded-3 mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white flex-shrink-0"
                                         style="width: 38px; height: 38px;">
                                        <i class="fa-solid fa-money-bill-transfer"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-success">Loan Amount Disbursed Successfully</div>
                                        <div class="text-secondary small mt-1" style="font-size: 0.8rem;">
                                            The approved capital of <strong>₹@app.PrincipalAmount.ToString("N2")</strong> was successfully credited to your selected bank account:
                                            <strong>@(bank?.BankName ?? "Linked Bank")</strong> (A/C: <strong>@(bank?.MaskedAccountNumber ?? "—")</strong>) via Instant IMPS.
                                        </div>
                                        @if (disb != null && !string.IsNullOrEmpty(disb.TransactionReference))
                                        {
                                            <div class="text-muted font-monospace small mt-2" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-receipt me-1"></i> Transaction Ref: <strong>@disb.TransactionReference</strong>
                                                @if (disb.CompletedAtUtc.HasValue)
                                                {
                                                    <span> &bull; Disbursed on: @disb.CompletedAtUtc.Value.ToString("dd MMM yyyy, hh:mm tt") UTC</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end flex-wrap">
                                <a asp-action="PayEmi" asp-route-loanId="@app.LoanId" class="btn btn-sm btn-success py-1 px-3 fw-bold shadow-xs">
                                    <i class="fa-solid fa-credit-card me-1"></i> Pay EMI Online
                                </a>
                                <a asp-action="Schedule" asp-route-loanId="@app.LoanId" class="bp-btn bp-btn-primary bp-btn-sm py-1 px-3">
                                    <i class="fa-solid fa-calendar-days me-1"></i> View EMI Schedule
                                </a>
                                <a asp-action="LoanDetails" asp-route-id="@app.LoanId" class="bp-btn bp-btn-secondary bp-btn-sm py-1 px-3">
                                    <i class="fa-solid fa-file-invoice me-1"></i> Loan Details
                                </a>
                            </div>
                        }
                        else if (isPending)
                        {
                            <div class="p-3 bg-warning-subtle border border-warning-subtle rounded-3 d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning text-dark flex-shrink-0"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa-solid fa-spinner fa-spin"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Under Review by FinGuard Loan Officer</div>
                                    <div class="text-secondary small" style="font-size: 0.8rem;">
                                        Your loan request has been sent to the admin portal. The loan officer is reviewing your KYC verification, income declarations, and bank account genuineness. You will receive an instant update once adjudicated.
                                    </div>
                                </div>
                            </div>
                        }
                        else if (isRejected)
                        {
                            <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-3 mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white flex-shrink-0"
                                         style="width: 38px; height: 38px;">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-danger">Loan Application Rejected</div>
                                        <div class="text-dark small mt-1">
                                            <strong>Reason for Rejection:</strong>
                                            <span class="text-danger fw-semibold">
                                                @(string.IsNullOrEmpty(disb?.Remarks) ? "Application does not meet institutional credit criteria or documentation standards." : disb.Remarks)
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-2" style="font-size: 0.78rem;">
                                            Please resolve the above issue (e.g. check bank details, verify KYC records, or adjust requested principal) before submitting a new application.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-sm py-1 px-3">
                                    <i class="fa-solid fa-rotate-right me-1"></i> Re-apply with Updated Particulars
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bp-card p-5 text-center my-3 shadow-sm">
            <div class="bp-kpi-icon indigo mx-auto mb-2"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i></div>
            <h2 class="fs-6 fw-bold text-dark mb-1">No Loan Requests Yet</h2>
            <p class="text-secondary small mb-3">You have not submitted any loan applications. Complete your KYC and apply for instant microfinance capital.</p>
            <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-sm py-2 px-3">Apply for a Loan</a>
        </div>
    }
</div>
