@model List<FinGuard.Models.Loan>

@{
    ViewData["Title"] = "Track Applications";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="fs-5 fw-bold text-dark mb-0">Loan Applications</h1>
            <p class="text-secondary small mb-0">Track verification stage & field appraisals</p>
        </div>
        <div>
            <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-sm py-1 px-3">
                <i class="fa-solid fa-plus me-1"></i> Apply
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3 mb-3 rounded-3 small border-success-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check text-success fs-5" aria-hidden="true"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (Model.Any())
    {
        <!-- Mobile Cards Stack (< 768px) -->
        <div class="d-flex flex-column gap-2 d-md-none mb-4">
            @foreach (var app in Model)
            {
                <div class="bp-card p-3 mb-0 border shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                        <span class="fw-bold text-dark small">#APP-@app.LoanId</span>
                        @if (app.Status == "Active")
                        {
                            <span class="bp-badge bp-badge-success" style="font-size: 0.7rem;"><span class="bp-badge-dot"></span> Approved & Active</span>
                        }
                        else if (app.Status == "Pending")
                        {
                            <span class="bp-badge bp-badge-warning" style="font-size: 0.7rem;"><span class="bp-badge-dot"></span> Under Appraisal</span>
                        }
                        else
                        {
                            <span class="bp-badge bp-badge-neutral" style="font-size: 0.7rem;"><span class="bp-badge-dot"></span> @app.Status</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="text-muted small" style="font-size: 0.72rem;">Requested Capital</div>
                            <div class="fs-6 fw-bold text-dark num-tabular">₹@app.PrincipalAmount.ToString("N2")</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small" style="font-size: 0.72rem;">Monthly Installment</div>
                            <div class="fs-6 fw-bold text-indigo num-tabular">₹@app.EMIAmount.ToString("N2")</div>
                        </div>
                    </div>

                    <div class="p-2 rounded bg-light border small mb-2" style="font-size: 0.75rem;">
                        <span class="text-muted">Tenure:</span> <strong class="text-dark">@app.TenureMonths Months</strong> |
                        <span class="text-muted">Interest:</span> <strong class="text-dark">@app.InterestRate% p.a.</strong>
                    </div>

                    <div>
                        @if (app.Status == "Active")
                        {
                            <a asp-action="LoanDetails" asp-route-id="@app.LoanId" class="bp-btn bp-btn-secondary w-100 py-1 text-center text-decoration-none" style="font-size: 0.78rem;">
                                <i class="fa-solid fa-eye me-1"></i> View Loan Details
                            </a>
                        }
                        else if (app.Status == "Pending")
                        {
                            <div class="d-flex align-items-center gap-2 text-warning small" style="font-size: 0.74rem;">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                <span>Stage 2: Assigned to Field Officer for Center Appraisal</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Table (>= 768px) -->
        <div class="bp-card bp-card-flush d-none d-md-block shadow-sm">
            <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark small">Application Queue & History</span>
                <span class="text-muted small">@Model.Count Application Records</span>
            </div>

            <div class="bp-table-responsive">
                <table class="bp-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 140px;">Application Ref</th>
                            <th scope="col" class="text-end">Requested Capital</th>
                            <th scope="col" class="text-center">Tenure</th>
                            <th scope="col" class="text-end">Monthly EMI</th>
                            <th scope="col">Verification Stage</th>
                            <th scope="col" class="text-center" style="width: 140px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    #APP-@app.LoanId
                                </td>
                                <td class="text-end num-tabular fw-semibold text-dark">
                                    ₹@app.PrincipalAmount.ToString("N2")
                                </td>
                                <td class="text-center num-tabular text-secondary">
                                    @app.TenureMonths Months
                                </td>
                                <td class="text-end num-tabular fw-semibold text-indigo">
                                    ₹@app.EMIAmount.ToString("N2")
                                </td>
                                <td>
                                    @if (app.Status == "Active")
                                    {
                                        <div class="d-flex align-items-center gap-2 small text-success fw-medium">
                                            <i class="fa-solid fa-circle-check"></i>
                                            <span>Approved & Disbursed to Borrower Account</span>
                                        </div>
                                    }
                                    else if (app.Status == "Pending")
                                    {
                                        <div class="d-flex align-items-center gap-2 small text-warning fw-medium">
                                            <i class="fa-solid fa-spinner fa-spin"></i>
                                            <span>Stage 2: Assigned to Field Officer for Center Appraisal</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2 small text-secondary">
                                            <i class="fa-solid fa-info-circle"></i>
                                            <span>Archived Record</span>
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (app.Status == "Active")
                                    {
                                        <span class="bp-badge bp-badge-success"><span class="bp-badge-dot"></span> Approved</span>
                                    }
                                    else if (app.Status == "Pending")
                                    {
                                        <span class="bp-badge bp-badge-warning"><span class="bp-badge-dot"></span> Under Review</span>
                                    }
                                    else
                                    {
                                        <span class="bp-badge bp-badge-neutral"><span class="bp-badge-dot"></span> @app.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bp-card p-5 text-center my-3 shadow-sm">
            <div class="bp-kpi-icon indigo mx-auto mb-2"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i></div>
            <h2 class="fs-6 fw-bold text-dark mb-1">No Applications in Queue</h2>
            <p class="text-secondary small mb-3">You have not submitted any pending loan requests.</p>
            <a asp-action="Apply" class="bp-btn bp-btn-primary bp-btn-sm py-2 px-3">Apply for a Loan</a>
        </div>
    }
</div>
