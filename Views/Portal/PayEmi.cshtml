@model FinGuard.Models.PayEmiViewModel

@{
    ViewData["Title"] = $"Pay Installment - Loan #LN-{Model.LoanId}";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Top Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="LoanDetails" asp-route-id="@Model.LoanId" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-secondary fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Loan Details
        </a>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small fw-semibold">
            <i class="fa-solid fa-shield-halved me-1"></i> 256-Bit Bank-Grade SSL
        </span>
    </div>

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fs-5 fw-bold text-dark mb-0">Pay Installment</h1>
        <p class="text-secondary small mb-0">Instant digital installment repayment and settlement gateway</p>
    </div>

    @{
        var allActiveLoans = ViewBag.AllActiveLoans as List<FinGuard.Models.Loan>;
    }
    @if (allActiveLoans != null && allActiveLoans.Count > 1)
    {
        <div class="bp-card p-3 mb-3 border shadow-xs bg-light">
            <span class="d-block small fw-bold text-secondary mb-2">Switch Active Loan Facility:</span>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var l in allActiveLoans)
                {
                    <a asp-action="PayEmi" asp-route-loanId="@l.LoanId" class="btn btn-sm @(l.LoanId == Model.LoanId ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 py-1">
                        <i class="fa-solid fa-file-invoice me-1"></i> Loan #LN-@l.LoanId (EMI: ₹@l.EMIAmount.ToString("N0"))
                    </a>
                }
            </div>
        </div>
    }

    <!-- Facility Overview Card -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
            <div>
                <span class="text-secondary small d-block" style="font-size: 0.72rem;">Loan Account Facility</span>
                <span class="fs-6 fw-bold text-dark">#LN-@Model.LoanId</span>
            </div>
            <div class="text-end">
                <span class="text-secondary small d-block" style="font-size: 0.72rem;">Due Date</span>
                <span class="badge bg-light text-secondary border fw-bold">@Model.NextDueDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>

        <div class="row g-2 mb-2 text-center">
            <div class="col-6">
                <div class="p-2 bg-light rounded-3">
                    <span class="text-muted d-block" style="font-size: 0.7rem;">Current Monthly EMI</span>
                    <strong class="fs-5 text-indigo num-tabular">₹@Model.EMIAmount.ToString("N2")</strong>
                </div>
            </div>
            <div class="col-6">
                <div class="p-2 bg-light rounded-3">
                    <span class="text-muted d-block" style="font-size: 0.7rem;">Outstanding Balance</span>
                    <strong class="fs-5 text-dark num-tabular">₹@Model.RemainingBalance.ToString("N2")</strong>
                </div>
            </div>
        </div>

        <div class="text-muted small text-center" style="font-size: 0.72rem;">
            Completed: <strong>@Model.PaidInstallmentsCount</strong> of <strong>@Model.TotalInstallmentsCount</strong> monthly installments
        </div>
    </div>

    <!-- Payment Amount Options -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-3">
            <i class="fa-solid fa-coins text-warning me-1"></i> Select Payment Amount
        </span>

        <div class="d-flex flex-column gap-2 mb-3">
            <!-- Option 1: Standard EMI -->
            <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer payment-option-card border-primary bg-light" style="cursor: pointer;">
                <div class="d-flex align-items-center gap-2">
                    <input type="radio" name="payOption" value="@Model.EMIAmount" data-type="EMI" class="form-check-input mt-0" checked />
                    <div>
                        <div class="fw-bold text-dark small">Standard Monthly EMI</div>
                        <div class="text-secondary small" style="font-size: 0.72rem;">Clears current scheduled installment</div>
                    </div>
                </div>
                <div class="fs-6 fw-bold text-indigo num-tabular">₹@Model.EMIAmount.ToString("N2")</div>
            </label>

            <!-- Option 2: Full Foreclosure -->
            @if (Model.ForeclosureAmount > 0)
            {
                <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer payment-option-card" style="cursor: pointer;">
                    <div class="d-flex align-items-center gap-2">
                        <input type="radio" name="payOption" value="@Model.ForeclosureAmount" data-type="Foreclosure" class="form-check-input mt-0" />
                        <div>
                            <div class="fw-bold text-dark small d-flex align-items-center gap-1">
                                Full Loan Settlement
                                <span class="badge bg-success rounded-pill px-2 py-0" style="font-size: 0.65rem;">Save ₹@Model.ForeclosureSavings:N0</span>
                            </div>
                            <div class="text-secondary small" style="font-size: 0.72rem;">Closes facility permanently & marks credit healthy</div>
                        </div>
                    </div>
                    <div class="fs-6 fw-bold text-success num-tabular">₹@Model.ForeclosureAmount.ToString("N2")</div>
                </label>
            }

            <!-- Option 3: Custom Partial Amount -->
            <label class="p-3 border rounded-3 d-flex flex-column gap-2 cursor-pointer payment-option-card" style="cursor: pointer;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <input type="radio" name="payOption" value="custom" data-type="Custom" class="form-check-input mt-0" />
                        <div>
                            <div class="fw-bold text-dark small">Custom Part-Payment</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;">Pay any custom amount toward balance</div>
                        </div>
                    </div>
                    <span class="text-muted small" style="font-size: 0.72rem;">Min ₹100 - Max ₹@Model.RemainingBalance:N0</span>
                </div>
                <div id="customAmountWrap" class="mt-2 d-none">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white fw-bold">₹</span>
                        <input type="number" id="customAmountInput" class="form-control" placeholder="Enter custom amount" min="100" max="@Model.RemainingBalance" step="1" />
                    </div>
                </div>
            </label>
        </div>

        <!-- Payment Channel Selection -->
        <span class="fw-bold text-dark small d-block mb-3 pt-2 border-top">
            <i class="fa-solid fa-building-columns text-primary me-1"></i> Select Payment Method
        </span>

        <div class="d-flex flex-column gap-2 mb-3">
            <!-- Channel 1: UPI -->
            <div class="p-3 border rounded-3 channel-card border-primary bg-light" style="cursor: pointer;" onclick="selectChannel('UPI', this)">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <input type="radio" name="paymentChannel" id="channelUpi" value="UPI" class="form-check-input mt-0" checked />
                        <div>
                            <strong class="text-dark small d-block">UPI Instant Pay</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">Google Pay, PhonePe, Paytm, BHIM UPI</span>
                        </div>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">Zero Fee</span>
                </div>
                <div id="upiInputBox" class="mt-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-at text-muted"></i></span>
                        <input type="text" id="upiIdInput" class="form-control" placeholder="Enter Virtual Payment Address (e.g. mobile@upi)" value="@($"{Model.Customer.Phone}@upi")" />
                    </div>
                </div>
            </div>

            <!-- Channel 2: Net Banking -->
            <div class="p-3 border rounded-3 channel-card" style="cursor: pointer;" onclick="selectChannel('NetBanking', this)">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <input type="radio" name="paymentChannel" id="channelNetBanking" value="Net Banking" class="form-check-input mt-0" />
                        <div>
                            <strong class="text-dark small d-block">Internet Banking</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">All major Indian public & private scheduled banks</span>
                        </div>
                    </div>
                    <span class="badge bg-light text-secondary border rounded-pill small">Instant</span>
                </div>
                <div id="netBankingBox" class="mt-2 d-none">
                    <select id="bankSelect" class="form-select form-select-sm">
                        <option value="State Bank of India">State Bank of India (SBI)</option>
                        <option value="HDFC Bank" selected>HDFC Bank</option>
                        <option value="ICICI Bank">ICICI Bank</option>
                        <option value="Axis Bank">Axis Bank</option>
                        <option value="Bank of Baroda">Bank of Baroda</option>
                        <option value="Punjab National Bank">Punjab National Bank</option>
                        <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
                    </select>
                </div>
            </div>

            <!-- Channel 3: Debit Card / RuPay -->
            <div class="p-3 border rounded-3 channel-card" style="cursor: pointer;" onclick="selectChannel('DebitCard', this)">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <input type="radio" name="paymentChannel" id="channelDebitCard" value="Debit Card" class="form-check-input mt-0" />
                        <div>
                            <strong class="text-dark small d-block">Debit Card / RuPay</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">Visa, MasterCard, and RuPay debit cards</span>
                        </div>
                    </div>
                    <span class="badge bg-light text-secondary border rounded-pill small">Secure</span>
                </div>
            </div>
        </div>

        <!-- Total Payable Summary -->
        <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between mb-3">
            <div>
                <span class="text-secondary small d-block" style="font-size: 0.72rem;">Total Payable Amount</span>
                <span class="fw-bold text-dark small">Instant Ledger Settlement</span>
            </div>
            <div class="text-end">
                <span class="fs-4 fw-bold text-indigo num-tabular" id="displayPayAmount">₹@Model.EMIAmount.ToString("N2")</span>
            </div>
        </div>

        <!-- Security Credentials Notice -->
        <div class="d-flex align-items-center gap-2 text-muted small mb-3" style="font-size: 0.72rem;">
            <i class="fa-solid fa-shield-halved text-success"></i>
            <span>256-bit bank-grade encryption • Verified NPCI/RBI banking switch • Zero credential retention</span>
        </div>

        <!-- Submit Button -->
        <button type="button" id="btnInitiatePayment" class="bp-btn bp-btn-primary w-100 py-3 fs-6 justify-content-center shadow-sm">
            <i class="fa-solid fa-lock me-2"></i> <span id="btnPayText">Pay ₹@Model.EMIAmount.ToString("N2") Securely</span>
        </button>

        <div id="paymentFeedback" class="mt-3 small text-center d-none"></div>
    </div>
</div>

<!-- Bank Payment Authorization Modal -->
<div class="modal fade" id="bankAuthModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0">FinGuard Secure Payment Authorization</h6>
                        <span class="text-muted" style="font-size: 0.7rem;">Core Microfinance Banking Switch</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="modalCloseBtn"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-secondary small">Loan Facility:</span>
                        <strong class="text-dark small">#LN-@Model.LoanId</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-secondary small">Borrower:</span>
                        <span class="text-dark small fw-medium">@Model.Customer.Name</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-secondary small">Payment Channel:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small" id="modalChannelBadge">UPI</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-secondary small fw-medium">Debited Amount:</span>
                        <span class="fs-4 fw-bold text-indigo num-tabular" id="modalPayAmount">₹@Model.EMIAmount.ToString("N2")</span>
                    </div>
                </div>

                <div class="mb-3" id="pinStep">
                    <label class="form-label small fw-semibold text-secondary">Enter 4-Digit Banking / UPI PIN to Authorize</label>
                    <div class="d-flex justify-content-center gap-2 mb-2">
                        <input type="password" maxlength="1" class="form-control text-center fs-5 fw-bold pin-digit" style="width: 48px; height: 48px;" value="1" />
                        <input type="password" maxlength="1" class="form-control text-center fs-5 fw-bold pin-digit" style="width: 48px; height: 48px;" value="2" />
                        <input type="password" maxlength="1" class="form-control text-center fs-5 fw-bold pin-digit" style="width: 48px; height: 48px;" value="3" />
                        <input type="password" maxlength="1" class="form-control text-center fs-5 fw-bold pin-digit" style="width: 48px; height: 48px;" value="4" />
                    </div>
                    <span class="text-muted d-block text-center small" style="font-size: 0.72rem;">Enter your confidential security authorization PIN.</span>
                </div>

                <div id="processingState" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-1" id="processStatusText">Connecting to National Banking Switch...</h6>
                    <p class="text-secondary small mb-0">Please do not refresh or close this browser window.</p>
                </div>

                <div class="d-flex gap-2" id="modalActionButtons">
                    <button type="button" class="btn btn-light w-50 py-2 small rounded-pill border" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnConfirmAuthorize" class="bp-btn bp-btn-primary w-50 py-2 small justify-content-center rounded-pill">
                        <i class="fa-solid fa-lock me-1"></i> Authorize & Pay
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Anti-Forgery Form Token for Requests -->
<form id="afForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        let currentSelectedAmount = @Model.EMIAmount;
        let selectedPaymentChannel = "UPI";
        const loanId = @Model.LoanId;
        const remainingBalance = @Model.RemainingBalance;

        function selectChannel(channel, element) {
            selectedPaymentChannel = channel;
            document.querySelectorAll('.channel-card').forEach(c => c.classList.remove('border-primary', 'bg-light'));
            element.classList.add('border-primary', 'bg-light');

            const radio = element.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;

            const upiBox = document.getElementById('upiInputBox');
            const netBankingBox = document.getElementById('netBankingBox');

            if (upiBox) upiBox.classList.toggle('d-none', channel !== 'UPI');
            if (netBankingBox) netBankingBox.classList.toggle('d-none', channel !== 'NetBanking');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const radioOptions = document.querySelectorAll('input[name="payOption"]');
            const customWrap = document.getElementById('customAmountWrap');
            const customInput = document.getElementById('customAmountInput');
            const displayAmount = document.getElementById('displayPayAmount');
            const btnPayText = document.getElementById('btnPayText');
            const btnPay = document.getElementById('btnInitiatePayment');
            const feedback = document.getElementById('paymentFeedback');
            const afToken = document.querySelector('#afForm input[name="__RequestVerificationToken"]')?.value || '';

            const authModalEl = document.getElementById('bankAuthModal');
            const authModal = new bootstrap.Modal(authModalEl);
            const modalPayAmount = document.getElementById('modalPayAmount');
            const modalChannelBadge = document.getElementById('modalChannelBadge');
            const btnConfirmAuthorize = document.getElementById('btnConfirmAuthorize');
            const pinStep = document.getElementById('pinStep');
            const processingState = document.getElementById('processingState');
            const processStatusText = document.getElementById('processStatusText');
            const modalActionButtons = document.getElementById('modalActionButtons');
            const modalCloseBtn = document.getElementById('modalCloseBtn');

            // Handle Amount Selection
            radioOptions.forEach(radio => {
                radio.addEventListener('change', function () {
                    document.querySelectorAll('.payment-option-card').forEach(c => {
                        c.classList.remove('border-primary', 'bg-light');
                    });
                    this.closest('.payment-option-card').classList.add('border-primary', 'bg-light');

                    const type = this.getAttribute('data-type');
                    if (type === 'Custom') {
                        customWrap.classList.remove('d-none');
                        const customVal = parseFloat(customInput.value) || 0;
                        currentSelectedAmount = customVal;
                        updateDisplay(customVal);
                    } else {
                        customWrap.classList.add('d-none');
                        const val = parseFloat(this.value) || 0;
                        currentSelectedAmount = val;
                        updateDisplay(val);
                    }
                });
            });

            if (customInput) {
                customInput.addEventListener('input', function () {
                    let val = parseFloat(this.value) || 0;
                    if (val > remainingBalance) {
                        val = remainingBalance;
                        this.value = val;
                    }
                    currentSelectedAmount = val;
                    updateDisplay(val);
                });
            }

            function updateDisplay(val) {
                const formatted = '₹' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                displayAmount.textContent = formatted;
                if (btnPayText) {
                    btnPayText.textContent = `Pay ${formatted} Securely`;
                }
            }

            // Click Pay Button -> Open Bank Authorization Modal
            btnPay.addEventListener('click', function () {
                if (currentSelectedAmount <= 0) {
                    showFeedback('Please enter or select a valid payment amount.', 'danger');
                    return;
                }
                if (currentSelectedAmount > remainingBalance) {
                    showFeedback('Payment amount cannot exceed the total outstanding balance of ₹' + remainingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 }), 'danger');
                    return;
                }

                modalPayAmount.textContent = '₹' + currentSelectedAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                modalChannelBadge.textContent = selectedPaymentChannel;

                pinStep.classList.remove('d-none');
                processingState.classList.add('d-none');
                modalActionButtons.classList.remove('d-none');
                modalCloseBtn.classList.remove('d-none');

                authModal.show();
            });

            // Confirm Authorization & Transfer
            btnConfirmAuthorize.addEventListener('click', function () {
                pinStep.classList.add('d-none');
                modalActionButtons.classList.add('d-none');
                modalCloseBtn.classList.add('d-none');
                processingState.classList.remove('d-none');

                processStatusText.textContent = 'Connecting to Secure Banking Gateway...';

                setTimeout(() => {
                    processStatusText.textContent = 'Authorizing transaction with Core Banking Switch...';
                }, 800);

                setTimeout(() => {
                    executePayment();
                }, 1600);
            });

            function executePayment() {
                const formData = new FormData();
                formData.append('loanId', loanId);
                formData.append('amount', currentSelectedAmount);
                formData.append('paymentMethod', selectedPaymentChannel);
                formData.append('__RequestVerificationToken', afToken);

                fetch('@Url.Action("ProcessPayment", "Portal")', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        processStatusText.textContent = 'Payment Authorized! Generating Official Receipt...';
                        setTimeout(() => {
                            window.location.href = data.redirectUrl;
                        }, 600);
                    } else {
                        authModal.hide();
                        showFeedback(data.message || 'Payment authorization failed. Please try again.', 'danger');
                    }
                })
                .catch(err => {
                    console.error(err);
                    authModal.hide();
                    showFeedback('Unable to connect to banking gateway. Please try again.', 'danger');
                });
            }

            function showFeedback(msg, type) {
                feedback.className = `alert alert-${type} mt-3 p-2 small`;
                feedback.textContent = msg;
                feedback.classList.remove('d-none');
            }
        });
    </script>
}
