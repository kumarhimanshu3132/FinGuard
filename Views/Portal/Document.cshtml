@model FinGuard.Models.Loan

@{
    var customer = ViewBag.Customer as FinGuard.Models.Customer;
    string docType = ViewBag.DocType as string ?? "kfs";
    
    string docTitle = docType switch
    {
        "sanction" => "OFFICIAL LOAN SANCTION LETTER",
        "agreement" => "MICROFINANCE CREDIT AGREEMENT",
        "application" => "LOAN APPLICATION DECLARATION",
        _ => "KEY FACT STATEMENT (KFS)"
    };

    ViewData["Title"] = $"{docTitle} - #{Model.LoanId}";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <div class="d-flex align-items-center justify-content-between mb-3 no-print">
        <a asp-action="LoanDetails" asp-route-id="@Model.LoanId" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-secondary fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Loan
        </a>
        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print / Save PDF
        </button>
    </div>

    <div class="bp-card p-4 p-md-5 bg-white shadow-sm border">
        <!-- Letterhead -->
        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="bp-brand-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <span class="fs-4 fw-bold text-dark">FinGuard Microfinance</span>
                </div>
                <div class="text-secondary small">Digital Institutional Credit Platform • Registration #NBFC-MFI-2026</div>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark border px-3 py-2 small fw-bold">REF: #LN-@Model.LoanId</span>
                <div class="text-muted small mt-1">Date: @DateTime.UtcNow.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <div class="text-center my-3">
            <h2 class="fs-5 fw-bold text-dark text-uppercase letter-spacing mb-1">@docTitle</h2>
            <p class="text-secondary small mb-0">Under Regulatory Microfinance Lending Guidelines</p>
        </div>

        <!-- Borrower Details -->
        <div class="p-3 bg-light rounded-3 border mb-4 small">
            <div class="row g-2">
                <div class="col-6">
                    <span class="text-muted">Borrower Full Legal Name:</span>
                    <div class="fw-bold text-dark">@(customer?.Name ?? "Registered Borrower")</div>
                </div>
                <div class="col-6">
                    <span class="text-muted">Customer ID:</span>
                    <div class="fw-bold text-dark">#@Model.CustomerId</div>
                </div>
                <div class="col-6">
                    <span class="text-muted">Mobile Number:</span>
                    <div class="fw-bold text-dark">+91 @(customer?.Phone ?? "XXXXXXXXXX")</div>
                </div>
                <div class="col-6">
                    <span class="text-muted">Registered Email:</span>
                    <div class="fw-bold text-dark">@(customer?.Email ?? "N/A")</div>
                </div>
                <div class="col-12 mt-2">
                    <span class="text-muted">Residential Address:</span>
                    <div class="fw-bold text-dark">@(customer?.Address ?? "Field Center"), PIN: @(customer?.PinCode ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- Loan Parameter Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50%;">Credit Parameter</th>
                        <th>Approved Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-secondary">Sanctioned Principal Amount</td>
                        <td class="fw-bold text-dark">₹@Model.PrincipalAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Annualized Interest Rate (APR)</td>
                        <td class="fw-bold text-dark">@Model.InterestRate% per annum (Fixed)</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Repayment Tenure</td>
                        <td class="fw-bold text-dark">@Model.TenureMonths Months</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Equated Monthly Installment (EMI)</td>
                        <td class="fw-bold text-indigo">₹@Model.EMIAmount.ToString("N2") per month</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Total Amount Payable over Tenure</td>
                        <td class="fw-bold text-dark">₹@((Model.EMIAmount * Model.TenureMonths).ToString("N2"))</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Foreclosure / Prepayment Penalty</td>
                        <td class="fw-bold text-success">NIL (Zero Exit Penalty)</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Cooling-Off / Look-Up Period</td>
                        <td class="fw-bold text-dark">3 Calendar Days</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Grievance Redressal Officer Contact</td>
                        <td class="fw-bold text-dark">support@finguard.in • Toll-Free: 1800-419-5959</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Statutory Terms -->
        <div class="small text-secondary mb-4" style="font-size: 0.78rem; line-height: 1.5;">
            <p><strong>Declarations & Microfinance Covenant:</strong></p>
            <ol class="ps-3 mb-0">
                <li>The borrower confirms that the sanctioned loan facility was applied for income-generating microcredit or personal liquidity purposes.</li>
                <li>Repayments shall be credited digitally or during scheduled center collection meetings with authorized FinGuard personnel.</li>
                <li>FinGuard adheres to ethical recovery practices and transparent disclosure standards.</li>
            </ol>
        </div>

        <!-- Signatures -->
        <div class="row pt-4 border-top mt-4 text-center small text-secondary">
            <div class="col-6">
                <div class="fw-bold text-dark">FinGuard Authorized Signatory</div>
                <div class="text-muted" style="font-size: 0.72rem;">Digital Credit Underwriting Desk</div>
            </div>
            <div class="col-6">
                <div class="fw-bold text-dark">@(customer?.Name ?? "Borrower")</div>
                <div class="text-muted" style="font-size: 0.72rem;">Digitally Verified via OTP / e-Sign</div>
            </div>
        </div>
    </div>
</div>
