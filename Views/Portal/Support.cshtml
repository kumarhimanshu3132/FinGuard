@{
    ViewData["Title"] = "Customer Help & Support";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Top Action / Back -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Dashboard" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
        <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
            24x7 Borrower Care
        </span>
    </div>

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fs-5 fw-bold text-dark mb-0">Help & Support</h1>
        <p class="text-secondary small mb-0">Helpline, center meeting assistance & RBI fair lending charter</p>
    </div>

    <!-- Support Channels Card -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-3">
            <i class="fa-solid fa-headset text-indigo me-1"></i> Official Assistance Channels
        </span>

        <div class="row g-2">
            <div class="col-12 col-sm-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa-solid fa-phone text-indigo fs-5"></i>
                        <strong class="text-dark small">Toll-Free Helpline</strong>
                    </div>
                    <div class="fs-6 fw-bold text-dark num-tabular mb-1">1800-123-4567</div>
                    <div class="text-muted small" style="font-size: 0.72rem;">Mon - Sat (9:00 AM - 6:00 PM)</div>
                </div>
            </div>

            <div class="col-12 col-sm-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa-solid fa-envelope text-indigo fs-5"></i>
                        <strong class="text-dark small">Borrower Support Desk</strong>
                    </div>
                    <div class="fs-6 fw-bold text-dark mb-1 text-truncate" style="font-size: 0.9rem;">support@finguard.in</div>
                    <div class="text-muted small" style="font-size: 0.72rem;">Inquiries & official correspondence</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fair Lending Charter Card -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-2">
            <i class="fa-solid fa-shield-check text-success me-1"></i> Microfinance Borrower Rights Charter
        </span>
        <ul class="text-secondary small mb-0 ps-3 d-flex flex-column gap-2" style="font-size: 0.78rem; line-height: 1.45;">
            <li><strong>Transparent Terms:</strong> All lending charges, annualized interest rates, and EMI schedules are disclosed upfront without hidden processing deductions.</li>
            <li><strong>Authorized Receipts:</strong> Every installment handed to a field officer must be immediately logged into the FinGuard system, with an accessible digital voucher.</li>
            <li><strong>Respectful Recovery:</strong> Recovery officers are strictly bound by institutional decorum. Collections take place exclusively during designated daytime center meetings (8:00 AM – 7:00 PM).</li>
            <li><strong>No Pre-closure Penalty:</strong> Borrowers may clear their outstanding ledger balance ahead of scheduled tenure without incurring penalty fees.</li>
        </ul>
    </div>

    <!-- Grievance Redressal Officer -->
    <div class="bp-card p-3 mb-3 border shadow-sm bg-light">
        <span class="fw-bold text-dark small d-block mb-1">
            <i class="fa-solid fa-scale-balanced text-indigo me-1"></i> Nodal Grievance Redressal
        </span>
        <div class="text-secondary small" style="font-size: 0.75rem; line-height: 1.45;">
            If your complaint is not resolved within 14 working days, you may escalate to:
            <div class="fw-semibold text-dark mt-1">Mr. Rajesh Sharma, Principal Grievance Officer</div>
            <div class="text-muted">FinGuard Microfinance Hub, Level 4, Tech Enclave, New Delhi - 110001</div>
            <div class="text-muted">Email: grievance@finguard.in | Direct: 011-4982-1200</div>
        </div>
    </div>

    <!-- FAQs Accordion -->
    <div class="bp-card p-3 p-md-4 mb-4 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-3">
            <i class="fa-solid fa-circle-question text-indigo me-1"></i> Frequently Asked Questions
        </span>

        <div class="accordion" id="supportFaq">
            <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                <h2 class="accordion-header" id="faqH1">
                    <button class="accordion-button fw-semibold text-dark small py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqC1" style="font-size: 0.82rem;">
                        How can I update my residential address?
                    </button>
                </h2>
                <div id="faqC1" class="accordion-collapse collapse show" data-bs-parent="#supportFaq">
                    <div class="accordion-body text-secondary small p-3" style="font-size: 0.78rem;">
                        You can update your residential address and postal PIN directly from the <a asp-action="Profile" class="fw-semibold text-indigo">My Profile</a> section. Field officers verify the address during your next center meeting.
                    </div>
                </div>
            </div>

            <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                <h2 class="accordion-header" id="faqH2">
                    <button class="accordion-button collapsed fw-semibold text-dark small py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqC2" style="font-size: 0.82rem;">
                        What should I do if a payment receipt does not appear?
                    </button>
                </h2>
                <div id="faqC2" class="accordion-collapse collapse" data-bs-parent="#supportFaq">
                    <div class="accordion-body text-secondary small p-3" style="font-size: 0.78rem;">
                        Field officers sync their collection devices by the end of each business day. If a payment does not reflect in your <a asp-action="Repayments" class="fw-semibold text-indigo">Repayment History</a> within 24 hours, contact your branch coordinator immediately.
                    </div>
                </div>
            </div>

            <div class="accordion-item border mb-0 rounded-3 overflow-hidden">
                <h2 class="accordion-header" id="faqH3">
                    <button class="accordion-button collapsed fw-semibold text-dark small py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#faqC3" style="font-size: 0.82rem;">
                        How does foreclosure early settlement work?
                    </button>
                </h2>
                <div id="faqC3" class="accordion-collapse collapse" data-bs-parent="#supportFaq">
                    <div class="accordion-body text-secondary small p-3" style="font-size: 0.78rem;">
                        In FinGuard, foreclosing your loan early saves future unaccrued interest charges. You can inspect exact foreclosure amounts and your savings directly in the <a asp-action="Loans" class="fw-semibold text-indigo">Loan Details</a> view.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
