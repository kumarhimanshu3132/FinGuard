@{
    ViewData["Title"] = "Repayment Guidelines & Status";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Top Back Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Dashboard" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
        </a>
        <a asp-action="Repayments" class="btn btn-sm btn-outline-primary px-3 py-1 small" style="font-size: 0.78rem;">
            <i class="fa-solid fa-receipt me-1"></i> View Receipts
        </a>
    </div>

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fs-5 fw-bold text-dark mb-0">Repayment Protocols</h1>
        <p class="text-secondary small mb-0">Standard microfinance installment collection guidelines & security</p>
    </div>

    <!-- Protocols Card -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-3">
            <i class="fa-solid fa-hand-holding-dollar text-indigo me-1"></i> How Installments are Collected & Credited
        </span>

        <div class="d-flex flex-column gap-2 mb-3">
            <div class="p-3 bg-light rounded-3 border d-flex gap-3 align-items-start">
                <div class="bp-kpi-icon indigo flex-shrink-0" style="width: 38px; height: 38px; font-size: 1rem;"><i class="fa-solid fa-users-line"></i></div>
                <div>
                    <strong class="text-dark d-block small mb-1">1. Center Group Meetings (SHG / JLG)</strong>
                    <p class="text-secondary small mb-0" style="font-size: 0.76rem; line-height: 1.4;">
                        Microfinance repayments are collected during your scheduled monthly center meetings by an authorized FinGuard Field Collection Officer.
                    </p>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border d-flex gap-3 align-items-start">
                <div class="bp-kpi-icon success flex-shrink-0" style="width: 38px; height: 38px; font-size: 1rem;"><i class="fa-solid fa-receipt"></i></div>
                <div>
                    <strong class="text-dark d-block small mb-1">2. Instant Digital Ledger Recording</strong>
                    <p class="text-secondary small mb-0" style="font-size: 0.76rem; line-height: 1.4;">
                        The officer inputs the collected installment directly into the FinGuard system, immediately generating an authentic digital receipt and reducing your outstanding balance.
                    </p>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border d-flex gap-3 align-items-start">
                <div class="bp-kpi-icon indigo flex-shrink-0" style="width: 38px; height: 38px; font-size: 1rem;"><i class="fa-solid fa-building-columns"></i></div>
                <div>
                    <strong class="text-dark d-block small mb-1">3. Direct Online Gateway</strong>
                    <p class="text-secondary small mb-0" style="font-size: 0.76rem; line-height: 1.4;">
                        You can also clear dues directly through the portal with verified instant ledger settlement and automatic receipt dispatch to your verified email.
                    </p>
                </div>
            </div>
        </div>

        <!-- Borrower Security Advisory -->
        <div class="alert alert-warning small p-3 rounded-3 mb-0 border-warning-subtle" role="alert" style="font-size: 0.78rem;">
            <div class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Borrower Security Advisory</div>
            <p class="mb-0 text-secondary">
                Never hand cash to unauthorized individuals. Always verify that your digital receipt appears in the 
                <a asp-action="Repayments" class="fw-bold text-dark">Repayment History</a> section of this portal within 24 hours of collection.
            </p>
        </div>
    </div>
</div>
