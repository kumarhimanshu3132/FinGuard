@model FinGuard.Models.BankAccountCreateViewModel

@{
    ViewData["Title"] = "Add Bank Account";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Top Back Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="BankAccounts" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Accounts
        </a>
        <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
            Secure Enrollment
        </span>
    </div>

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fs-5 fw-bold text-dark mb-0">Link New Bank Account</h1>
        <p class="text-secondary small mb-0">Enter verified bank details for institutional loan payouts</p>
    </div>

    <div class="bp-card p-3 p-md-4 border shadow-sm">
        <form asp-action="AddBankAccount" method="post" id="addBankAccountForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3 rounded-3" role="alert"></div>

            <!-- Quick Bank Selection Chips (Google Pay / PhonePe Style) -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-2">Select Your Bank (UPI / NetBanking Style)</label>
                <div class="row row-cols-3 row-cols-md-4 g-2 mb-2" id="bankChipsContainer">
                    <div class="col">
                        <button type="button" class="btn btn-outline-primary w-100 p-2 text-center rounded-3 border bank-chip active" onclick="pickBank('SBI', 'State Bank of India', 'SBIN0001234', 11, '11 digits (e.g. 12345678901)')">
                            <span class="fw-bold d-block text-primary small">SBI</span>
                            <span class="text-muted" style="font-size: 0.68rem;">State Bank</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('HDFC', 'HDFC Bank', 'HDFC0000123', 14, '14 digits (e.g. 12345678901234)')">
                            <span class="fw-bold d-block text-danger small">HDFC</span>
                            <span class="text-muted" style="font-size: 0.68rem;">HDFC Bank</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('ICICI', 'ICICI Bank', 'ICIC0000001', 12, '12 digits (e.g. 123456789012)')">
                            <span class="fw-bold d-block text-warning small">ICICI</span>
                            <span class="text-muted" style="font-size: 0.68rem;">ICICI Bank</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('Axis', 'Axis Bank', 'UTIB0000001', 15, '15 digits (e.g. 123456789012345)')">
                            <span class="fw-bold d-block text-danger small">Axis</span>
                            <span class="text-muted" style="font-size: 0.68rem;">Axis Bank</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('PNB', 'Punjab National Bank', 'PUNB0000100', 16, '16 digits (e.g. 1234567890123456)')">
                            <span class="fw-bold d-block text-warning small">PNB</span>
                            <span class="text-muted" style="font-size: 0.68rem;">Punjab Nat.</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('BOB', 'Bank of Baroda', 'BARB0000001', 14, '14 digits (e.g. 12345678901234)')">
                            <span class="fw-bold d-block text-warning small">BOB</span>
                            <span class="text-muted" style="font-size: 0.68rem;">Baroda</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary w-100 p-2 text-center rounded-3 border bank-chip" onclick="pickBank('Kotak', 'Kotak Mahindra Bank', 'KKBK0000123', 10, '10 digits (e.g. 1234567890)')">
                            <span class="fw-bold d-block text-danger small">Kotak</span>
                            <span class="text-muted" style="font-size: 0.68rem;">Kotak Bank</span>
                        </button>
                    </div>
                </div>
                <div class="text-primary small" id="bankGuidanceText">
                    <i class="fa-solid fa-circle-info me-1"></i> Selected: <strong>State Bank of India</strong> — requires 11-digit account number & IFSC starting with <code>SBIN0...</code>
                </div>
            </div>

            <!-- Bank Name -->
            <div class="mb-3">
                <label asp-for="BankName" class="form-label small fw-semibold text-secondary">Bank Name *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fa-solid fa-building-columns"></i>
                    </span>
                    <input asp-for="BankName" id="bankNameField" class="form-control border-start-0" placeholder="e.g. State Bank of India, HDFC Bank, ICICI Bank" value="State Bank of India" required />
                </div>
                <span asp-validation-for="BankName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Account Holder Name -->
            <div class="mb-3">
                <label asp-for="AccountHolderName" class="form-label small fw-semibold text-secondary">Account Holder Name (as in passbook) *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <input asp-for="AccountHolderName" class="form-control border-start-0" placeholder="e.g. Sudhanshu Kumar" required />
                </div>
                <span asp-validation-for="AccountHolderName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Account Number -->
            <div class="mb-3">
                <label asp-for="AccountNumber" class="form-label small fw-semibold text-secondary">Bank Account Number *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fa-solid fa-hashtag"></i>
                    </span>
                    <input asp-for="AccountNumber" type="password" id="accountNumberInput" class="form-control border-start-0 border-end-0 font-monospace" placeholder="9 to 18 digits" autocomplete="off" required />
                    <button type="button" class="btn btn-outline-secondary border-start-0" onclick="toggleAccVisibility('accountNumberInput', this)">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="AccountNumber" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Confirm Account Number -->
            <div class="mb-3">
                <label asp-for="ConfirmAccountNumber" class="form-label small fw-semibold text-secondary">Confirm Account Number *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input asp-for="ConfirmAccountNumber" type="password" id="confirmAccountNumberInput" class="form-control border-start-0 border-end-0 font-monospace" placeholder="Re-enter bank account number" autocomplete="off" required />
                    <button type="button" class="btn btn-outline-secondary border-start-0" onclick="toggleAccVisibility('confirmAccountNumberInput', this)">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmAccountNumber" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- IFSC Code & Account Type -->
            <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                    <label asp-for="IFSCCode" class="form-label small fw-semibold text-secondary">IFSC Code (11 Chars) *</label>
                    <input asp-for="IFSCCode" id="ifscInput" class="form-control font-monospace text-uppercase" placeholder="e.g. SBIN0001234" value="SBIN0001234" maxlength="11" oninput="this.value = this.value.toUpperCase();" required />
                    <span asp-validation-for="IFSCCode" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="AccountType" class="form-label small fw-semibold text-secondary">Account Type *</label>
                    <select asp-for="AccountType" class="form-select">
                        <option value="Savings">Savings Account</option>
                        <option value="Current">Current Account</option>
                    </select>
                    <span asp-validation-for="AccountType" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <!-- Branch Name (Optional) -->
            <div class="mb-3">
                <label asp-for="BranchName" class="form-label small fw-semibold text-secondary">Branch Name (Optional)</label>
                <input asp-for="BranchName" class="form-control" placeholder="e.g. Connaught Place Branch" />
                <span asp-validation-for="BranchName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Set as Primary -->
            <div class="mb-4 form-check">
                <input asp-for="SetAsPrimary" class="form-check-input" id="setAsPrimaryCheck" checked />
                <label class="form-check-label small text-secondary" for="setAsPrimaryCheck">
                    Set as primary account for instant home loan credit
                </label>
            </div>

            <!-- Security Assurance -->
            <div class="p-3 bg-light rounded-3 border mb-3 small text-muted" style="font-size: 0.74rem;">
                <i class="fa-solid fa-circle-check text-success me-1"></i>
                <strong>College Project Demo Mode:</strong> Bank account format is validated according to official bank rules and instantly verified for loan application.
            </div>

            <!-- Actions -->
            <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                <a asp-action="BankAccounts" class="btn btn-sm btn-light border px-3 py-2">Cancel</a>
                <button type="submit" class="bp-btn bp-btn-primary px-4 py-2 fs-6">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Link Bank Account
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function pickBank(code, name, ifsc, digits, placeholder) {
            document.querySelectorAll('#bankChipsContainer .bank-chip').forEach(el => {
                el.classList.remove('active', 'btn-outline-primary');
                el.classList.add('btn-outline-secondary');
            });
            event.currentTarget.classList.add('active', 'btn-outline-primary');
            event.currentTarget.classList.remove('btn-outline-secondary');

            document.getElementById('bankNameField').value = name;
            document.getElementById('ifscInput').value = ifsc;
            
            const accInput = document.getElementById('accountNumberInput');
            const confirmInput = document.getElementById('confirmAccountNumberInput');
            accInput.placeholder = placeholder;
            confirmInput.placeholder = `Confirm ${digits} digits`;
            accInput.setAttribute('maxlength', digits);
            confirmInput.setAttribute('maxlength', digits);

            document.getElementById('bankGuidanceText').innerHTML = 
                `<i class="fa-solid fa-circle-info me-1"></i> Selected: <strong>${name}</strong> — requires ${digits}-digit account number & IFSC starting with <code>${ifsc.substring(0, 5)}...</code>`;
        }

        function toggleAccVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}
