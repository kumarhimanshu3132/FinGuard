@model FinGuard.Models.BorrowerDashboardViewModel

@{
    ViewData["Title"] = "Customer Dashboard - FinGuard";
    Layout = "_BorrowerLayout";

    bool hasBank = Model.HasVerifiedBank;
    bool hasPan = Model.HasVerifiedPan;
    bool hasAadhaar = Model.HasVerifiedAadhaar;
    bool hasPendingLoan = Model.PendingApplications.Any();
    bool hasActiveLoan = Model.ActiveLoans.Any();
    var primaryBank = Model.PrimaryBankAccount;
    var primaryLoan = Model.ActiveLoans.FirstOrDefault();
    var pendingLoan = Model.PendingApplications.FirstOrDefault();

    var allLoans = Model.AllLoans.Any() ? Model.AllLoans : Model.ActiveLoans.Concat(Model.PendingApplications).Concat(Model.ClosedLoans).OrderByDescending(l => l.LoanId).ToList();
    var repaymentsMap = ViewBag.LoanRepaymentsMap as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

<div class="bp-mobile-shell">
    @Html.AntiForgeryToken()

    <!-- Top Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3 mb-3 rounded-4 small border-success-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
            <div>@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-3 mb-3 rounded-4 small border-danger-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation text-danger fs-5 flex-shrink-0" aria-hidden="true"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <!-- 1. Hero Mission Banner (FinGuard Digital Lending Portal) -->
    <div class="bp-card p-3 p-md-4 mb-4 text-white position-relative overflow-hidden shadow-sm"
         style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); border-radius: 16px;">
        <div class="position-absolute end-0 bottom-0 opacity-10 pe-3 pb-2 d-none d-sm-block" style="font-size: 8rem; pointer-events: none;">
            <i class="fa-solid fa-house-laptop"></i>
        </div>

        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-white text-primary px-3 py-1 rounded-pill small fw-bold">
                <i class="fa-solid fa-shield-halved me-1"></i> FinGuard Digital Lending
            </span>
            <span class="badge bg-white bg-opacity-20 text-white px-2 py-1 rounded-pill small">
                Client Portal
            </span>
        </div>

        <h1 class="fs-4 fw-bold mb-1 text-white">Instant Digital Loan Application</h1>
        <p class="text-light opacity-90 small mb-3" style="max-width: 640px; line-height: 1.5;">
            Apply for credit directly from home without branch visits or physical paperwork. Manage your linked bank accounts, monitor your active loan facilities and repayments, and apply for instant credit in minutes.
        </p>

        <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
            <a asp-action="Apply" class="btn btn-warning text-dark fw-bold px-3 py-2 shadow-sm" style="border-radius: 10px;">
                <i class="fa-solid fa-plus-circle me-1"></i> Apply for Loan
            </a>
            <a asp-action="BankAccounts" class="btn btn-outline-light fw-semibold px-3 py-2" style="border-radius: 10px;">
                <i class="fa-solid fa-building-columns me-1"></i> Manage Bank Accounts
            </a>
            <a asp-action="Kyc" class="btn btn-outline-light fw-semibold px-3 py-2" style="border-radius: 10px;">
                <i class="fa-solid fa-id-card me-1"></i> KYC & Identity
            </a>
        </div>
    </div>

    <!-- 2. Financial Overview KPI Cards (Total Borrowed, Total Repaid, Outstanding, Limit) -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Total Sanctioned Principal -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="bp-card p-3 h-100 border shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Total Borrowed</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-primary bg-primary-subtle"
                         style="width: 38px; height: 38px; font-size: 1rem;">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-dark num-tabular mb-1">
                    ₹@Model.TotalSanctionedPrincipal.ToString("N0")
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.76rem;">
                    <span>Across all credit facilities</span>
                    <span class="badge bg-light text-dark border">@(Model.ActiveLoans.Count + Model.ClosedLoans.Count) Facilities</span>
                </div>
            </div>
        </div>

        <!-- KPI 2: Total Repaid Amount -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="bp-card p-3 h-100 border shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Total Repaid</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-success bg-success-subtle"
                         style="width: 38px; height: 38px; font-size: 1rem;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-success num-tabular mb-1">
                    ₹@Model.TotalRepaidAmount.ToString("N0")
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.76rem;">
                    <span>Verified cleared amount</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.RepaymentProgressPercentage% Cleared</span>
                </div>
            </div>
        </div>

        <!-- KPI 3: Current Outstanding Balance -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="bp-card p-3 h-100 border shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Outstanding Balance</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-warning bg-warning-subtle"
                         style="width: 38px; height: 38px; font-size: 1rem;">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-dark num-tabular mb-1">
                    ₹@Model.TotalOutstandingBalance.ToString("N0")
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.76rem;">
                    <span>Active principal remaining</span>
                    <span class="badge bg-light text-dark border">@Model.ActiveLoans.Count Active</span>
                </div>
            </div>
        </div>

        <!-- KPI 4: Credit Limit -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="bp-card p-3 h-100 border shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Available Credit</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-indigo bg-indigo-subtle"
                         style="width: 38px; height: 38px; font-size: 1rem; background: #eef2ff; color: #4338ca;">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-indigo num-tabular mb-1">
                    ₹@Model.AvailableCreditLimit.ToString("N0")
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.76rem;">
                    <span>Total Limit: ₹@Model.TotalApprovedCreditLimit.ToString("N0")</span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle">Pre-Approved</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Account Readiness & Verification Bar -->
    <div class="bp-card p-3 mb-4 bg-light border shadow-sm">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-dark small"><i class="fa-solid fa-user-shield text-primary me-1"></i> Account Readiness:</span>
                <div class="d-flex align-items-center gap-2 flex-wrap small">
                    <!-- Bank Status -->
                    <span class="badge @(hasBank ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-2 py-1">
                        <i class="fa-solid @(hasBank ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                        Bank: @(hasBank ? (primaryBank?.BankName ?? "Linked") : "Not Linked")
                    </span>

                    <!-- PAN Status -->
                    <span class="badge @(hasPan ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-2 py-1">
                        <i class="fa-solid @(hasPan ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                        PAN: @(hasPan ? "Verified" : "Pending")
                    </span>

                    <!-- Aadhaar Status -->
                    <span class="badge @(hasAadhaar ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-2 py-1">
                        <i class="fa-solid @(hasAadhaar ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                        Aadhaar: @(hasAadhaar ? "Verified" : "Pending")
                    </span>
                </div>
            </div>

            @if (!hasBank || !hasPan || !hasAadhaar)
            {
                <div class="d-flex align-items-center gap-2">
                    @if (!hasBank)
                    {
                        <a asp-action="AddBankAccount" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-plus me-1"></i> Link Bank
                        </a>
                    }
                    @if (!hasPan || !hasAadhaar)
                    {
                        <a asp-action="Kyc" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-id-card me-1"></i> Complete KYC
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 4. Section 1: Linked Bank Accounts (Disbursement Destination Accounts) -->
    <div class="bp-card p-3 p-md-4 mb-4 border shadow-sm">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary"
                         style="width: 32px; height: 32px; font-size: 0.95rem;">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <h2 class="fs-6 fw-bold text-dark mb-0">Linked Bank Accounts</h2>
                </div>
                <div class="text-muted small mt-1" style="font-size: 0.76rem;">
                    Registered disbursement accounts and authorized banking channels
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-action="AddBankAccount" class="btn btn-sm btn-primary py-1 px-3">
                    <i class="fa-solid fa-plus me-1"></i> Add Bank Account
                </a>
                <a asp-action="BankAccounts" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Manage all bank accounts">
                    View All
                </a>
            </div>
        </div>

        @if (Model.BankAccounts != null && Model.BankAccounts.Any())
        {
            <div class="row g-3">
                @foreach (var bank in Model.BankAccounts)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="p-3 bg-white rounded-3 border h-100 shadow-sm position-relative @(bank.IsPrimary ? "border-primary" : "")">
                            @if (bank.IsPrimary)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-primary text-white rounded-pill m-2 px-2 py-1" style="font-size: 0.65rem;">
                                    <i class="fa-solid fa-star me-1"></i> Primary
                                </span>
                            }

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                                     style="width: 36px; height: 36px; background: #1e3a8a; font-size: 0.95rem;">
                                    <i class="fa-solid fa-building-columns"></i>
                                </div>
                                <div>
                                    <h3 class="fs-6 fw-bold text-dark mb-0">@bank.BankName</h3>
                                    <span class="text-muted small" style="font-size: 0.72rem;">@bank.AccountType Account</span>
                                </div>
                            </div>

                            <div class="p-2 bg-light rounded-2 border mb-2 font-monospace small">
                                <div class="text-muted" style="font-size: 0.7rem;">ACCOUNT NUMBER</div>
                                <div class="fw-bold text-dark">@bank.MaskedAccountNumber</div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center text-muted small" style="font-size: 0.74rem;">
                                <span>IFSC: <strong class="text-dark">@bank.IFSCCode</strong></span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="fa-solid fa-check me-1"></i> Verified
                                </span>
                            </div>

                            <div class="mt-2 pt-2 border-top text-muted small text-truncate" style="font-size: 0.72rem;">
                                Holder: <strong class="text-dark">@bank.AccountHolderName</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 bg-light rounded-3 border">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary bg-white border mx-auto mb-2"
                     style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-1">No Bank Account Linked</h3>
                <p class="text-secondary small mb-3" style="max-width: 420px; margin: auto;">
                    You have not linked a bank account yet. Link your bank to receive approved loan disbursements directly into your account.
                </p>
                <a asp-action="AddBankAccount" class="bp-btn bp-btn-primary btn-sm px-3 py-1">
                    <i class="fa-solid fa-plus me-1"></i> Link Bank Account Now
                </a>
            </div>
        }
    </div>

    <!-- 5. Section 2: Loans & Borrowings by Bank (Disbursements and Repayment by Bank) -->
    <div class="bp-card p-3 p-md-4 mb-4 border shadow-sm">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary"
                         style="width: 32px; height: 32px; font-size: 0.95rem;">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                    <h2 class="fs-6 fw-bold text-dark mb-0">Your Loans & Bank Disbursements</h2>
                </div>
                <div class="text-muted small mt-1" style="font-size: 0.76rem;">
                    Breakdown of credit facilities, linked disbursement bank accounts, and repayment progress
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-action="Apply" class="btn btn-sm btn-primary py-1 px-3">
                    <i class="fa-solid fa-plus me-1"></i> Apply for Loan
                </a>
                <a asp-action="Loans" class="btn btn-sm btn-outline-secondary py-1 px-2">
                    View All Loans
                </a>
            </div>
        </div>

        @if (allLoans.Any())
        {
            <!-- Desktop Table View -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 110px;">Facility ID</th>
                            <th scope="col">Disbursement Bank</th>
                            <th scope="col" class="text-end">Loan Amount</th>
                            <th scope="col" class="text-end">Monthly EMI</th>
                            <th scope="col" class="text-end">Repaid Amount</th>
                            <th scope="col" class="text-end">Remaining Due</th>
                            <th scope="col" class="text-center" style="width: 120px;">Status</th>
                            <th scope="col" class="text-end" style="width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in allLoans)
                        {
                            var disbBank = loan.Disbursements?.FirstOrDefault()?.BankAccount 
                                           ?? Model.BankAccounts?.FirstOrDefault(b => b.IsPrimary) 
                                           ?? Model.BankAccounts?.FirstOrDefault();
                            decimal repaidForThisLoan = repaymentsMap.ContainsKey(loan.LoanId) ? repaymentsMap[loan.LoanId] : 0m;

                            <tr>
                                <td class="fw-bold text-dark">
                                    #@loan.LoanId
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-primary flex-shrink-0"
                                             style="width: 30px; height: 30px; font-size: 0.8rem;">
                                            <i class="fa-solid fa-building-columns"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block text-dark">@(disbBank?.BankName ?? "Verified Bank")</strong>
                                            <span class="text-muted small" style="font-size: 0.72rem;">
                                                A/C: @(disbBank?.MaskedAccountNumber ?? "••••")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark num-tabular">
                                    ₹@loan.PrincipalAmount.ToString("N0")
                                </td>
                                <td class="text-end fw-bold text-primary num-tabular">
                                    ₹@loan.EMIAmount.ToString("N2")/mo
                                </td>
                                <td class="text-end fw-semibold text-success num-tabular">
                                    ₹@repaidForThisLoan.ToString("N0")
                                </td>
                                <td class="text-end fw-bold text-dark num-tabular">
                                    ₹@loan.RemainingBalance.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @if (loan.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i> Active
                                        </span>
                                    }
                                    else if (loan.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="fa-solid fa-hourglass-half me-1"></i> In Review
                                        </span>
                                    }
                                    else if (loan.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i> Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border px-2 py-1">@loan.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="LoanDetails" asp-route-id="@loan.LoanId" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.78rem;">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards Stack (< 768px) -->
            <div class="d-flex flex-column gap-3 d-md-none">
                @foreach (var loan in allLoans)
                {
                    var disbBank = loan.Disbursements?.FirstOrDefault()?.BankAccount 
                                   ?? Model.BankAccounts?.FirstOrDefault(b => b.IsPrimary) 
                                   ?? Model.BankAccounts?.FirstOrDefault();
                    decimal repaidForThisLoan = repaymentsMap.ContainsKey(loan.LoanId) ? repaymentsMap[loan.LoanId] : 0m;

                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                            <span class="fw-bold text-dark">Loan #@loan.LoanId</span>
                            @if (loan.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else if (loan.Status == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">In Review</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@loan.Status</span>
                            }
                        </div>

                        <!-- Bank Name -->
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 bg-light rounded-2 border small">
                            <i class="fa-solid fa-building-columns text-primary"></i>
                            <div>
                                <span class="text-muted" style="font-size: 0.7rem;">DISBURSEMENT BANK:</span>
                                <strong class="d-block text-dark">@(disbBank?.BankName ?? "Verified Bank") (@(disbBank?.MaskedAccountNumber ?? "••••"))</strong>
                            </div>
                        </div>

                        <div class="row g-2 text-center mb-2" style="font-size: 0.78rem;">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded border">
                                    <span class="text-muted d-block" style="font-size: 0.7rem;">Sanctioned Loan</span>
                                    <strong class="text-dark num-tabular">₹@loan.PrincipalAmount.ToString("N0")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded border">
                                    <span class="text-muted d-block" style="font-size: 0.7rem;">Repaid Amount</span>
                                    <strong class="text-success num-tabular">₹@repaidForThisLoan.ToString("N0")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded border">
                                    <span class="text-muted d-block" style="font-size: 0.7rem;">Monthly EMI</span>
                                    <strong class="text-primary num-tabular">₹@loan.EMIAmount.ToString("N2")</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded border">
                                    <span class="text-muted d-block" style="font-size: 0.7rem;">Remaining Due</span>
                                    <strong class="text-dark num-tabular">₹@loan.RemainingBalance.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>

                        <a asp-action="LoanDetails" asp-route-id="@loan.LoanId" class="btn btn-sm btn-outline-primary w-100 py-1">
                            View Facility Details <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 bg-light rounded-3 border">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary bg-white border mx-auto mb-2"
                     style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
                <h3 class="fs-6 fw-bold text-dark mb-1">No Active Loans Yet</h3>
                <p class="text-secondary small mb-3" style="max-width: 420px; margin: auto;">
                    You have not taken any loans yet. Link your bank account and complete identity verification to apply for an instant loan.
                </p>
                <a asp-action="Apply" class="bp-btn bp-btn-primary btn-sm px-3 py-1">
                    <i class="fa-solid fa-plus-circle me-1"></i> Apply for Loan
                </a>
            </div>
        }
    </div>

    <!-- 6. Recent Payment Activity Section -->
    @if (Model.RecentRepayments != null && Model.RecentRepayments.Any())
    {
        <div class="bp-card p-3 p-md-4 mb-4 border shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success"
                         style="width: 32px; height: 32px; font-size: 0.95rem;">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <h2 class="fs-6 fw-bold text-dark mb-0">Recent Repayments</h2>
                </div>
                <a asp-action="Loans" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.75rem;">
                    View History
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Payment ID</th>
                            <th scope="col">Facility Ref</th>
                            <th scope="col">Payment Date</th>
                            <th scope="col">Payment Method</th>
                            <th scope="col" class="text-end">Amount Cleared</th>
                            <th scope="col" class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rep in Model.RecentRepayments)
                        {
                            <tr>
                                <td class="fw-bold text-dark font-monospace">#REP-@rep.RepaymentId</td>
                                <td>Loan #@rep.LoanId</td>
                                <td class="text-secondary">@rep.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fa-solid fa-shield-halved text-primary me-1"></i> @(string.IsNullOrEmpty(rep.PaymentMethod) ? "UPI / Net Banking" : rep.PaymentMethod)
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success num-tabular">
                                    ₹@rep.AmountPaid.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="fa-solid fa-circle-check me-1"></i> Cleared
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
