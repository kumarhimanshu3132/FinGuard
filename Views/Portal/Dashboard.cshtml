@model FinGuard.Models.BorrowerDashboardViewModel

@{
    ViewData["Title"] = "Borrower Home - FinGuard";
    Layout = "_BorrowerLayout";
}

<div class="bp-mobile-shell">
    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3 mb-3 rounded-4 small border-success-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check text-success fs-6" aria-hidden="true"></i>
            <div>@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-3 mb-3 rounded-4 small border-danger-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation text-danger fs-6" aria-hidden="true"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <!-- 1. Credit Limit Overview Card (mPokket style - Image 1) -->
    <div class="bp-credit-limit-card">
        <div class="bp-credit-meta">
            <span>Total Credit Limit:</span>
            <span class="fw-bold text-dark">₹@Model.TotalApprovedCreditLimit.ToString("N2")</span>
            <i class="fa-solid fa-circle-info text-secondary" style="font-size: 0.72rem;" title="Approved under institutional lending policy"></i>
        </div>

        <div class="bp-available-limit-label">Available Credit Limit:</div>
        <div class="bp-available-limit-val">
            ₹@Model.AvailableCreditLimit.ToString("N2")
        </div>

        <div>
            @if (Model.Customer.IsEligibleForLoan && Model.AvailableCreditLimit >= 5000)
            {
                <a asp-action="Apply" class="bp-btn-get-cash">
                    <span>Get Cash</span>
                    <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                </a>
            }
            else if (Model.ActiveLoans.Any())
            {
                <a asp-action="Loans" class="bp-btn-get-cash">
                    <span>Active Facility Active</span>
                    <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                </a>
            }
            else
            {
                <a asp-action="Apply" class="bp-btn-get-cash">
                    <span>Apply for Limit</span>
                    <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                </a>
            }
        </div>
    </div>

    <!-- 2. Upcoming Payment Card (Image 1 reference) -->
    @if (Model.PrimaryLoan != null && Model.PrimaryLoan.RemainingBalance > 0)
    {
        <div class="bp-upcoming-card">
            <div class="bp-upcoming-main">
                <div class="d-flex align-items-center gap-3">
                    <div class="bp-upcoming-icon-wrap">
                        <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="small text-secondary fw-medium">Upcoming Loan Amount</div>
                        <div class="bp-upcoming-amount">
                            ₹@Model.PrimaryLoan.EMIAmount.ToString("N2")
                        </div>
                        <div class="small text-muted" style="font-size: 0.72rem;">
                            Due on @Model.PrimaryLoan.NextDueDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>

                <div>
                    <a asp-action="PayEmi" asp-route-loanId="@Model.PrimaryLoan.LoanId" class="bp-btn-pay-sm">
                        Pay
                    </a>
                </div>
            </div>

            <div class="bp-upcoming-ribbon">
                <i class="fa-solid fa-circle-check text-warning"></i>
                <span>Pay on time to reopen limit up to ₹5,000 + save on interest</span>
            </div>
        </div>
    }
    else
    {
        <div class="p-3 bg-white rounded-4 border border-light-subtle shadow-sm mb-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="bp-upcoming-icon-wrap" style="background-color: #ecfdf5; color: #059669;">
                    <i class="fa-solid fa-shield-check"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark small">No Outstanding Installments Due</div>
                    <div class="text-secondary" style="font-size: 0.75rem;">Your account is in good standing.</div>
                </div>
            </div>
            <a asp-action="Apply" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.78rem;">
                New Loan
            </a>
        </div>
    }

    <!-- 3. Repay Loan & Cashback Banner (Image 1 reference) -->
    <div class="bp-promo-card">
        <span class="bp-promo-badge">Offer Live</span>
        <div style="font-size: 2rem; color: #93c5fd; margin-right: 0.25rem;">
            <i class="fa-solid fa-bullhorn"></i>
        </div>
        <div class="w-100">
            <div class="fw-bold" style="font-size: 0.95rem;">Repay your loan & get</div>
            <div class="bp-promo-boxes">
                <div class="bp-promo-box">
                    <span>Up to</span> <strong>₹300</strong> <span>cashback</span>
                </div>
                <div class="bp-promo-box">
                    <span>Gold points</span> <strong>+ Score</strong> <span>boost</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Explore FinGuard Quick Action Grid (Image 1 reference) -->
    <div class="bp-explore-section-title">Explore FinGuard</div>
    <div class="bp-explore-grid">
        <a asp-action="Loans" class="bp-explore-item">
            <div class="bp-explore-icon">
                <i class="fa-solid fa-wallet"></i>
                <span class="dot"></span>
            </div>
            <span class="bp-explore-label">My Loans</span>
        </a>

        <a asp-action="BankAccounts" class="bp-explore-item">
            <div class="bp-explore-icon" style="color: #2563eb;">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <span class="bp-explore-label">Bank Accounts</span>
        </a>

        <a asp-action="Disbursements" class="bp-explore-item">
            <div class="bp-explore-icon" style="color: #059669;">
                <i class="fa-solid fa-money-bill-transfer"></i>
            </div>
            <span class="bp-explore-label">Disburse</span>
        </a>

        <a asp-action="Schedule" class="bp-explore-item">
            <div class="bp-explore-icon" style="color: #6366f1;">
                <i class="fa-solid fa-calendar-days"></i>
            </div>
            <span class="bp-explore-label">Schedule</span>
        </a>

        <a asp-action="Kyc" class="bp-explore-item">
            <div class="bp-explore-icon" style="color: #ea580c;">
                <i class="fa-solid fa-id-card-clip"></i>
                @if (Model.Customer.KycStatus != "Verified")
                {
                    <span class="dot" style="background-color: #ef4444;"></span>
                }
            </div>
            <span class="bp-explore-label">KYC Status</span>
        </a>

        <a asp-action="Support" class="bp-explore-item">
            <div class="bp-explore-icon" style="color: #64748b;">
                <i class="fa-solid fa-circle-question"></i>
            </div>
            <span class="bp-explore-label">Help Center</span>
        </a>
    </div>

    <!-- 5. Financial Portfolio Metrics -->
    <div class="bp-card p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-bold text-dark small">Portfolio Summary</span>
            <span class="bp-badge @(Model.Customer.KycStatus == "Verified" ? "bp-badge-success" : "bp-badge-warning")">
                KYC @Model.Customer.KycStatus
            </span>
        </div>

        <div class="row g-2 text-center">
            <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                    <div class="text-secondary" style="font-size: 0.68rem;">Sanctioned</div>
                    <div class="fw-bold text-dark num-tabular small">₹@Model.TotalSanctionedPrincipal.ToString("N0")</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                    <div class="text-secondary" style="font-size: 0.68rem;">Total Repaid</div>
                    <div class="fw-bold text-success num-tabular small">₹@Model.TotalRepaidAmount.ToString("N0")</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                    <div class="text-secondary" style="font-size: 0.68rem;">Outstanding</div>
                    <div class="fw-bold text-danger num-tabular small">₹@Model.TotalOutstandingBalance.ToString("N0")</div>
                </div>
            </div>
        </div>

        @if (Model.ActiveLoans.Any())
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between small text-secondary fw-semibold mb-1" style="font-size: 0.75rem;">
                    <span>Recovery Progress</span>
                    <span>@Model.RepaymentProgressPercentage%</span>
                </div>
                <div class="bp-progress-bar-wrap" style="height: 6px;">
                    <div class="bp-progress-bar-fill" style="width: @Model.RepaymentProgressPercentage%;"></div>
                </div>
            </div>
        }
    </div>

    <!-- 6. Recent Verified Repayments -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="fw-bold text-dark small">Recent Payments</span>
        <a asp-action="Repayments" class="small text-decoration-none text-indigo fw-semibold">View All ></a>
    </div>

    @if (Model.RecentRepayments.Any())
    {
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var rep in Model.RecentRepayments.Take(3))
            {
                <div class="p-3 bg-white rounded-3 border border-light-subtle shadow-xs d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bp-kpi-icon success" style="width: 32px; height: 32px; font-size: 0.85rem;">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark small">EMI Repayment #REC-@rep.RepaymentId</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@rep.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-success num-tabular small">₹@rep.AmountPaid.ToString("N2")</div>
                        <a asp-action="Receipt" asp-route-id="@rep.RepaymentId" class="text-secondary" style="font-size: 0.72rem;">Receipt <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-4 bg-white rounded-4 border text-center text-muted small mb-3">
            <i class="fa-solid fa-receipt fs-4 text-secondary mb-2 d-block"></i>
            No past repayments recorded yet.
        </div>
    }
</div>
