@model FinGuard.Models.Customer

@{
    ViewData["Title"] = "KYC & Identity Verification";
    Layout = "_BorrowerLayout";
    bool isVerified = Model.KycStatus == "Verified";
}

<div class="bp-mobile-shell">
    <!-- Top Action / Back -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Dashboard" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
        <span class="badge @(isVerified ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1" style="font-size: 0.75rem;">
            @(isVerified ? "KYC Compliant" : "Verification Pending")
        </span>
    </div>

    <!-- Status Hero Card -->
    <div class="bp-card p-4 mb-3 border-0 shadow-sm text-center"
         style="background: @(isVerified ? "linear-gradient(135deg, #065f46 0%, #047857 100%)" : "linear-gradient(135deg, #92400e 0%, #b45309 100%)"); color: #fff;">
        <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3"
             style="width: 56px; height: 56px; background: rgba(255, 255, 255, 0.2); border: 2px solid rgba(255,255,255,0.4); font-size: 1.5rem;">
            <i class="fa-solid @(isVerified ? "fa-shield-check" : "fa-shield-halved")"></i>
        </div>
        <h1 class="fs-5 fw-bold text-white mb-1">
            @(isVerified ? "KYC Verification Active" : "Demographic Verification Pending")
        </h1>
        <p class="text-white-50 small mb-0" style="max-width: 440px; margin: 0 auto; font-size: 0.8rem; line-height: 1.4;">
            @(isVerified
                ? "Your identity and demographic credentials have been verified according to the Reserve Bank of India Microfinance Regulatory Framework."
                : "Your borrower account is created. Please present your original government documents to your field officer during the next center meeting.")
        </p>
    </div>

    <!-- Verification Milestones Checklist -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="fw-bold text-dark small">
                <i class="fa-solid fa-list-check text-indigo me-1"></i> Verification Milestones
            </span>
            <span class="text-muted small" style="font-size: 0.72rem;">@(isVerified ? "4 of 4 Verified" : "2 of 4 Verified")</span>
        </div>

        <div class="d-flex flex-column gap-2">
            <!-- 1. Mobile Phone -->
            <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-check text-success fs-5"></i>
                    <div>
                        <div class="fw-semibold text-dark small">Mobile Contact Channel</div>
                        <div class="text-muted small" style="font-size: 0.72rem;">@Model.CountryCode @Model.Phone</div>
                    </div>
                </div>
                <span class="bp-badge bp-badge-success" style="font-size: 0.7rem;">Verified</span>
            </div>

            <!-- 2. Email Address -->
            <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-check text-success fs-5"></i>
                    <div>
                        <div class="fw-semibold text-dark small">Registered Email Address</div>
                        <div class="text-muted small text-truncate" style="max-width: 170px; font-size: 0.72rem;">@Model.Email</div>
                    </div>
                </div>
                <span class="bp-badge bp-badge-success" style="font-size: 0.7rem;">6-Digit OTP</span>
            </div>

            <!-- 3. Demographic & Age Check -->
            <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-check text-success fs-5"></i>
                    <div>
                        <div class="fw-semibold text-dark small">Demographic Age & Name</div>
                        <div class="text-muted small" style="font-size: 0.72rem;">@Model.Name (DOB: @Model.DateOfBirth.ToString("dd MMM yyyy"))</div>
                    </div>
                </div>
                <span class="bp-badge bp-badge-success" style="font-size: 0.7rem;">18+ Verified</span>
            </div>

            <!-- 4. Document Verification -->
            <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    @if (isVerified)
                    {
                        <i class="fa-solid fa-circle-check text-success fs-5"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-clock text-warning fs-5"></i>
                    }
                    <div>
                        <div class="fw-semibold text-dark small">Official ID & Field Appraisal</div>
                        <div class="text-muted small" style="font-size: 0.72rem;">Aadhaar / Voter ID / Field Officer Appraisal</div>
                    </div>
                </div>
                @if (isVerified)
                {
                    <span class="bp-badge bp-badge-success" style="font-size: 0.7rem;">Verified</span>
                }
                else
                {
                    <span class="bp-badge bp-badge-warning" style="font-size: 0.7rem;">Pending Appraisal</span>
                }
            </div>
        </div>
    </div>

    <!-- Privacy & Data Encryption Assurance -->
    <div class="bp-card p-3 mb-3 border shadow-sm">
        <div class="fw-bold text-dark small mb-2">
            <i class="fa-solid fa-lock text-indigo me-1"></i> Data Security & Privacy Notice
        </div>
        <p class="text-secondary small mb-2" style="font-size: 0.78rem; line-height: 1.45;">
            FinGuard protects your identity in accordance with the <strong>Digital Personal Data Protection Act (DPDP)</strong> and RBI regulations. All identity records are secured using AES-256 bit encryption and are never shared with unauthorized third parties.
        </p>
        <div class="p-2 bg-light rounded border text-muted small" style="font-size: 0.72rem;">
            <i class="fa-solid fa-circle-info text-primary me-1"></i> Field coordinators only verify documents in your physical presence during regular Self-Help Group meetings.
        </div>
    </div>

    <!-- Actions -->
    <div class="d-grid gap-2 mb-4">
        <a asp-action="Profile" class="bp-btn bp-btn-primary text-center py-2" style="font-size: 0.85rem;">
            <i class="fa-solid fa-user-pen me-1"></i> Review Profile & Residential Address
        </a>
        <a asp-action="Support" class="bp-btn bp-btn-secondary text-center py-2" style="font-size: 0.85rem;">
            <i class="fa-solid fa-headset me-1 text-indigo"></i> Need Help with Verification?
        </a>
    </div>
</div>
