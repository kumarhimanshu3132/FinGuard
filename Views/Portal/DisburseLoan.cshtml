@model FinGuard.Models.DisbursementInitiateViewModel

@{
    ViewData["Title"] = "Confirm Loan Disbursement";
    Layout = "_BorrowerLayout";
    var customer = ViewBag.Customer as FinGuard.Models.Customer;
    bool hasVerifiedAccount = ViewBag.HasVerifiedAccount as bool? ?? false;
}

<div class="bp-mobile-shell">
    <!-- Top Back Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Disbursements" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Hub
        </a>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill small">
            Step 2 of 2: Payout Review
        </span>
    </div>

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fs-5 fw-bold text-dark mb-0">Disburse Loan Facility</h1>
        <p class="text-secondary small mb-0">Authorize payout for Sanctioned Facility #@Model.LoanId</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-3 mb-3 rounded-3 small border-danger-subtle shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation text-danger fs-5 flex-shrink-0" aria-hidden="true"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <!-- Financial Breakdown Card -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <span class="fw-bold text-dark small d-block mb-3">
            <i class="fa-solid fa-calculator text-indigo me-1"></i> Capital & Net Payout Breakdown
        </span>

        <div class="d-flex flex-column gap-2 mb-3">
            <div class="d-flex justify-content-between align-items-center small">
                <span class="text-secondary">Approved Principal Amount:</span>
                <span class="fw-bold text-dark fs-6 num-tabular">₹@Model.PrincipalAmount.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center small">
                <span class="text-secondary">Institutional Processing & Documentation Fee:</span>
                <span class="text-danger fw-semibold num-tabular">- ₹@Model.Deductions.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <div>
                    <span class="fw-bold text-dark fs-6 d-block">Estimated Net Payout:</span>
                    <span class="text-muted small" style="font-size: 0.72rem;">Credited directly to destination bank account</span>
                </div>
                <span class="fs-4 fw-bold text-success num-tabular">₹@Model.NetPayout.ToString("N2")</span>
            </div>
        </div>

        <div class="p-2 rounded bg-light border small text-muted" style="font-size: 0.74rem;">
            <span>Loan Facility ID: <strong>#@Model.LoanId</strong></span> |
            <span>Tenure: <strong>@Model.Loan?.TenureMonths Months</strong></span> |
            <span>Monthly EMI: <strong>₹@Model.Loan?.EMIAmount.ToString("N2")</strong></span>
        </div>
    </div>

    <!-- Payout Form -->
    <div class="bp-card p-3 p-md-4 mb-3 border shadow-sm">
        <form asp-action="ConfirmDisbursement" method="post" id="confirmDisbursementForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="loanId" value="@Model.LoanId" />

            <!-- Destination Account Selector -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Select Destination Bank Account *</label>

                @if (Model.AvailableBankAccounts != null && Model.AvailableBankAccounts.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var acc in Model.AvailableBankAccounts)
                        {
                            <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer @(acc.Id == Model.SelectedBankAccountId ? "border-primary bg-light" : "")" style="cursor: pointer;">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="bankAccountId" value="@acc.Id" @(acc.Id == Model.SelectedBankAccountId ? "checked" : "") class="form-check-input mt-0" required />
                                    <div>
                                        <div class="fw-bold text-dark small">@acc.BankName (@acc.AccountType)</div>
                                        <div class="text-secondary small font-monospace" style="font-size: 0.74rem;">
                                            @acc.MaskedAccountNumber • IFSC: @acc.IFSCCode
                                        </div>
                                    </div>
                                </div>
                                @if (acc.IsPrimary)
                                {
                                    <span class="badge bg-primary rounded-pill px-2 py-1" style="font-size: 0.68rem;">Primary</span>
                                }
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning small p-3 rounded-3 mb-0">
                        No verified bank accounts available.
                        <a asp-action="AddBankAccount" class="fw-bold text-dark">Add Account</a>
                    </div>
                }
            </div>

            <!-- Institutional Disbursement Agreement -->
            <div class="p-3 rounded-3 border mb-3 bg-light">
                <div class="d-flex align-items-start gap-2">
                    <i class="fa-solid fa-shield-halved text-success mt-1 flex-shrink-0"></i>
                    <div>
                        <strong class="text-dark small d-block mb-1">Disbursement Authorization & Terms</strong>
                        <p class="text-secondary small mb-2" style="font-size: 0.76rem; line-height: 1.4;">
                            You are authorizing the credit transfer of sanctioned loan capital into your verified bank account.
                            By confirming, you agree to the repayment schedule and institutional lending policies.
                        </p>
                        <div class="form-check">
                            <input type="checkbox" name="termsConfirmed" value="true" class="form-check-input" id="confirmTermsCheck" required />
                            <label class="form-check-label small fw-semibold text-dark" for="confirmTermsCheck" style="font-size: 0.78rem;">
                                I confirm and authorize the transfer of loan funds to my designated bank account.
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                <a asp-action="Disbursements" class="btn btn-sm btn-light border px-3 py-2">Cancel</a>
                <button type="submit" class="bp-btn bp-btn-primary px-4 py-2 fs-6" id="btnSubmitDisbursement">
                    <i class="fa-solid fa-bolt me-1"></i> Authorize & Disburse Funds
                </button>
            </div>
        </form>
    </div>
</div>
