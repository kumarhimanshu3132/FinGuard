@model FinGuard.Models.LoanDisbursement

@{
    ViewData["Title"] = $"Disbursement Voucher #{Model.TransactionReference}";
    Layout = "_BorrowerLayout";
    var customer = ViewBag.Customer as FinGuard.Models.Customer;
}

<div class="bp-mobile-shell">
    <!-- Top Action Bar -->
    <div class="no-print d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Disbursements" class="btn btn-sm btn-light border text-secondary px-3 py-1">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Disbursements
        </a>
        <button type="button" class="bp-btn bp-btn-primary bp-btn-sm py-1 px-3" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print / Save Voucher
        </button>
    </div>

    <!-- Voucher Card -->
    <div class="bp-card p-4 p-md-5 bg-white border shadow-sm">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="bp-brand-icon" style="width: 32px; height: 32px; font-size: 0.95rem;">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h1 class="fs-5 fw-bold text-dark mb-0">FinGuard Microfinance</h1>
                </div>
                <div class="text-secondary small" style="font-size: 0.76rem;">Institutional Lending Operations • Automated Payout Ledger</div>
            </div>
            <div class="text-end">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 fw-bold" style="font-size: 0.72rem;">
                    SIMULATED PAYOUT SUCCESS
                </span>
                <div class="text-muted small mt-1 font-monospace" style="font-size: 0.72rem;">@Model.TransactionReference</div>
            </div>
        </div>

        <!-- Meta Grid -->
        <div class="row g-3 mb-3 small">
            <div class="col-6">
                <span class="text-secondary d-block" style="font-size: 0.72rem;">Borrower Legal Name:</span>
                <strong class="text-dark">@(customer?.Name ?? "Verified Borrower")</strong>
            </div>
            <div class="col-6">
                <span class="text-secondary d-block" style="font-size: 0.72rem;">Customer Portfolio ID:</span>
                <strong class="text-dark">#@Model.CustomerId</strong>
            </div>
            <div class="col-6">
                <span class="text-secondary d-block" style="font-size: 0.72rem;">Loan Facility Reference:</span>
                <strong class="text-dark">#LN-@Model.LoanId</strong>
            </div>
            <div class="col-6">
                <span class="text-secondary d-block" style="font-size: 0.72rem;">Transaction Timestamp:</span>
                <strong class="text-dark">@Model.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm:ss tt") UTC</strong>
            </div>
        </div>

        <!-- Destination Bank Card -->
        <div class="p-3 bg-light rounded-3 border mb-3 small">
            <span class="text-secondary d-block fw-semibold mb-1" style="font-size: 0.72rem;">Credited Bank Destination:</span>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <strong class="text-dark d-block">@Model.BankAccount?.BankName (@Model.BankAccount?.AccountType)</strong>
                    <span class="text-muted font-monospace" style="font-size: 0.75rem;">
                        @Model.BankAccount?.MaskedAccountNumber • IFSC: @Model.BankAccount?.IFSCCode
                    </span>
                </div>
                <div class="text-end">
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.7rem;">@Model.PaymentMode</span>
                </div>
            </div>
        </div>

        <!-- Breakdown Table -->
        <div class="border rounded-3 overflow-hidden mb-3">
            <table class="table table-sm mb-0 small">
                <tbody>
                    <tr>
                        <td class="text-secondary p-2 ps-3">Sanctioned Principal Capital</td>
                        <td class="text-end fw-semibold text-dark p-2 pe-3 num-tabular">₹@Model.PrincipalAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-secondary p-2 ps-3">Institutional Processing & Documentation Fee</td>
                        <td class="text-end text-danger p-2 pe-3 num-tabular">- ₹@Model.Deductions.ToString("N2")</td>
                    </tr>
                    <tr class="table-light border-top">
                        <td class="fw-bold text-dark p-2 ps-3 fs-6">Net Disbursed Capital</td>
                        <td class="text-end fw-bold text-success p-2 pe-3 fs-6 num-tabular">₹@Model.NetDisbursedAmount.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Simulation Notice Footer -->
        <div class="p-3 rounded-3 border text-center small" style="background-color: #f8fafc; font-size: 0.75rem;">
            <div class="fw-bold text-secondary mb-1">
                <i class="fa-solid fa-flask-vial text-primary me-1"></i> Demo Transaction — No real money transferred
            </div>
            <div class="text-muted">
                This digital voucher verifies sandbox payout completion under FinGuard Microfinance credit protocol.
            </div>
        </div>
    </div>
</div>
