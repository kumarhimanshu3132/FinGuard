<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinGuard</title>
    <!-- Bootstrap for Grid and core structure -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome for modern icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinGuard.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="fg-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="fg-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-shield-halved"></i> FinGuard
            </a>
            
            <nav class="d-flex gap-2 align-items-center">
                <a class="fg-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="fg-nav-link" asp-area="" asp-controller="Customer" asp-action="Index">Customers</a>
                <a class="fg-nav-link" asp-area="" asp-controller="Loan" asp-action="Index">Loans</a>
                <a class="fg-nav-link" asp-area="" asp-controller="Repayment" asp-action="Index">Collections</a>
                
                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="dropdown ms-3 pl-3 border-start">
                        <a class="fg-nav-link dropdown-toggle" href="#" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user-circle"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end fg-card p-2" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item rounded" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button type="button" class="dropdown-item rounded text-danger" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
                                </button>
                            </li>
                        </ul>
                    </div>
                }
            </nav>
        </div>
    </header>

    <div class="container flex-grow-1 d-flex flex-column">
        <main role="main" class="pb-5 pt-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="fg-footer mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 FinGuard. All rights reserved.
            </div>
            <div class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="fg-nav-link p-0">Privacy Policy</a>
                <a href="#" class="fg-nav-link p-0">Terms of Service</a>
            </div>
        </div>
    </footer>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 p-0" style="background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-light" id="logoutModalLabel">Confirm Logout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-light opacity-75">
                    Are you sure you want to log out of the Admin Portal?
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn px-4 fw-bold text-white rounded-pill" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);">Yes, Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>