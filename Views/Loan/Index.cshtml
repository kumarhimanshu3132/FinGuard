@model IEnumerable<FinGuard.Models.Loan>

@{
    ViewData["Title"] = "Loan Directory";
    var totalLoans = Model != null ? Model.Count() : 0;
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-file-invoice-dollar text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Loan Directory
            <span class="fg-count-badge">@totalLoans Loans</span>
        </h1>
        <p class="fg-page-subtitle">Disbursed loan ledger, active tenures, EMI schedules, and recovery tracking.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="fg-btn fg-btn-primary fg-btn-sm">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Issue New Loan</span>
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div id="loanAlertSuccess" class="fg-alert fg-alert-success" role="alert">
        <i class="fa-solid fa-circle-check fg-alert-icon" aria-hidden="true"></i>
        <div class="fg-alert-content">@TempData["Success"]</div>
    </div>
}

<!-- Table Card with Search & Filters -->
<div class="fg-card fg-card-flush">
    <!-- Filter & Search Bar -->
    <div class="fg-filter-bar">
        <div class="fg-search-input-group">
            <i class="fa-solid fa-magnifying-glass fg-search-icon" aria-hidden="true"></i>
            <input type="text" id="loanSearchInput" class="fg-search-input"
                   placeholder="Search by Loan ID or Customer ID..." aria-label="Search loans" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="loanStatusFilter" class="fg-filter-select" aria-label="Filter by Loan Status">
                <option value="">All Loan Statuses</option>
                <option value="Active">Active</option>
                <option value="Closed">Closed</option>
                <option value="Defaulter">Defaulter</option>
                <option value="Pending">Pending</option>
            </select>
        </div>
    </div>

    <!-- Responsive Table -->
    <div class="fg-table-responsive">
        <table class="fg-table">
            <thead>
                <tr>
                    <th scope="col" style="width: 110px;">Loan ID</th>
                    <th scope="col" style="width: 130px;">Customer ID</th>
                    <th scope="col" class="text-end">Principal Amount</th>
                    <th scope="col" class="text-center">Interest</th>
                    <th scope="col" class="text-center">Tenure</th>
                    <th scope="col" class="text-end">Monthly EMI</th>
                    <th scope="col" class="text-end">Remaining Balance</th>
                    <th scope="col" class="text-center" style="width: 120px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="loan-row"
                            data-search="@item.LoanId @item.CustomerId"
                            data-status="@item.Status">
                            <td>
                                <span class="fg-row-id">#@item.LoanId</span>
                            </td>
                            <td>
                                <a asp-controller="Customer" asp-action="Edit" asp-route-id="@item.CustomerId"
                                   class="fw-semibold text-primary" title="View customer profile">
                                    #@item.CustomerId
                                </a>
                            </td>
                            <td class="text-end num-tabular fw-semibold text-dark">
                                ₹@item.PrincipalAmount.ToString("N2")
                            </td>
                            <td class="text-center num-tabular text-secondary">
                                @item.InterestRate% p.a.
                            </td>
                            <td class="text-center num-tabular text-secondary">
                                @item.TenureMonths Mos
                            </td>
                            <td class="text-end num-tabular fw-semibold" style="color: var(--fg-primary);">
                                ₹@item.EMIAmount.ToString("N2")
                            </td>
                            <td class="text-end num-tabular fw-semibold"
                                style="color: @(item.RemainingBalance > 0 ? "var(--fg-danger)" : "var(--fg-success)");">
                                ₹@item.RemainingBalance.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Active")
                                {
                                    <span class="fg-badge fg-badge-success">
                                        <span class="fg-badge-dot"></span>
                                        Active
                                    </span>
                                }
                                else if (item.Status == "Closed")
                                {
                                    <span class="fg-badge fg-badge-neutral">
                                        <span class="fg-badge-dot"></span>
                                        Closed
                                    </span>
                                }
                                else if (item.Status == "Defaulter")
                                {
                                    <span class="fg-badge fg-badge-danger">
                                        <span class="fg-badge-dot"></span>
                                        Defaulter
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <span class="fg-badge fg-badge-warning">
                                            <span class="fg-badge-dot"></span>
                                            Pending
                                        </span>
                                        <form asp-action="Approve" asp-route-id="@item.LoanId" method="post" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2 fw-semibold" style="font-size: 0.72rem;" title="Approve for disbursement">
                                                <i class="fa-solid fa-check me-1"></i> Approve
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="fg-badge fg-badge-success">
                                        <span class="fg-badge-dot"></span>
                                        Approved (@item.DisbursementStatus)
                                    </span>
                                }
                                else
                                {
                                    <span class="fg-badge fg-badge-neutral">
                                        <span class="fg-badge-dot"></span>
                                        @item.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="p-0">
                            <div class="fg-empty-state">
                                <div class="fg-empty-icon">
                                    <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
                                </div>
                                <h3 class="fg-empty-title">No Loans Found</h3>
                                <p class="fg-empty-desc">There are no loans issued in the system. Issue a new microfinance loan to an eligible customer.</p>
                                <a asp-action="Create" class="fg-btn fg-btn-primary fg-btn-sm">
                                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                    <span>Issue New Loan</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('loanSearchInput');
            const statusFilter = document.getElementById('loanStatusFilter');
            const rows = document.querySelectorAll('.loan-row');

            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
                const statusVal = statusFilter ? statusFilter.value : '';

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    const rowStatus = row.getAttribute('data-status') || '';

                    const matchesQuery = !query || searchData.includes(query);
                    const matchesStatus = !statusVal || rowStatus === statusVal;

                    if (matchesQuery && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (statusFilter) statusFilter.addEventListener('change', applyFilters);

            const alertSuccess = document.getElementById('loanAlertSuccess');
            if (alertSuccess) {
                setTimeout(() => {
                    alertSuccess.style.transition = 'opacity 400ms ease';
                    alertSuccess.style.opacity = '0';
                    setTimeout(() => alertSuccess.remove(), 400);
                }, 4000);
            }
        })();
    </script>
}