@model IEnumerable<FinGuard.Models.Loan>

@{
    ViewData["Title"] = "Active Loans";
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
        margin-top: 1rem;
    }

    .header-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    .btn-add {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border: none;
        box-shadow: 0 8px 16px -4px rgba(99, 102, 241, 0.3);
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -4px rgba(99, 102, 241, 0.5);
        color: white;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
        color: var(--text-primary);
    }

    .custom-table th {
        background: rgba(0, 0, 0, 0.2);
        color: var(--text-primary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .custom-table td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        color: var(--text-primary);
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
    }

    .amount-text {
        color: var(--success-color);
        font-weight: 700;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: rgba(16, 185, 129, 0.2);
        color: var(--success-color);
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center" style="max-width: 1000px; margin: 1rem auto 2.5rem;">
    <h2 class="header-title mb-0" style="color: var(--text-primary);">Loan Directory</h2>
    <a href="/Loan/Create" class="btn-add">+ Issue New Loan</a>
</div>

<div class="fg-card" style="max-width: 1000px; margin: 0 auto; padding: 0; overflow: hidden;">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th class="text-light">Loan ID</th>
                    <th class="text-light">Customer ID</th>
                    <th class="text-light">Principal</th>
                    <th class="text-light">Tenure</th>
                    <th class="text-light">Monthly EMI</th>
                    <th class="text-light">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-light opacity-75">#@item.LoanId</td>
                            <td class="fw-bold text-light">#@item.CustomerId</td>
                            <td class="amount-text">₹@item.PrincipalAmount</td>
                            <td class="text-light">@item.TenureMonths Mos</td>
                            <td class="fw-bold" style="color: var(--accent-secondary);">₹@item.EMIAmount</td>
                            <td>
                                <span class="status-badge">@item.Status</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <h5 class="fw-bold text-light">No active loans</h5>
                            <p class="text-light opacity-75 mb-0">Click "+ Issue New Loan" to process an application.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>