@model FinGuard.Models.Loan

@{
    ViewData["Title"] = "Issue New Loan";
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-file-signature text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Issue Microfinance Loan
        </h1>
        <p class="fg-page-subtitle">Configure loan terms, select verified borrower, and compute dynamic EMI schedule.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to Loans</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="fg-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">Borrower & Account Assignment</h2>
                    <p class="fg-form-section-desc">Assign loan record to an onboarded, KYC-verified customer.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LoanId" class="fg-form-label">
                                Assigned Loan ID <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="LoanId" type="number" class="form-control num-tabular"
                                   placeholder="e.g. 5001" required />
                            <span asp-validation-for="LoanId" class="text-danger small mt-1 d-block"></span>
                            <div class="fg-input-hint">Unique numerical identifier for the loan ledger.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="fg-form-label">
                                Select Borrower <span class="required text-danger">*</span>
                            </label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" required>
                                <option value="">-- Choose Verified Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small mt-1 d-block"></span>
                            <div class="fg-input-hint">Customer must have completed KYC verification.</div>
                        </div>
                    </div>
                </div>

                <div class="fg-form-section">
                    <h2 class="fg-form-section-title">Financial Terms & Tenures</h2>
                    <p class="fg-form-section-desc">Specify disbursement capital and repayment duration.</p>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="PrincipalAmount" class="fg-form-label">
                                Principal Amount (₹) <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="PrincipalAmount" id="PrincipalAmount" type="number" step="0.01" min="1"
                                   class="form-control num-tabular calc-input" placeholder="e.g. 50000" required />
                            <span asp-validation-for="PrincipalAmount" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InterestRate" class="fg-form-label">
                                Annual Interest Rate (%) <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="InterestRate" id="InterestRate" type="number" step="0.01" min="0" max="100"
                                   class="form-control num-tabular calc-input" placeholder="e.g. 12" required />
                            <span asp-validation-for="InterestRate" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TenureMonths" class="fg-form-label">
                                Duration (Months) <span class="required text-danger">*</span>
                            </label>
                            <input asp-for="TenureMonths" id="TenureMonths" type="number" min="1" max="120"
                                   class="form-control num-tabular calc-input" placeholder="e.g. 12" required />
                            <span asp-validation-for="TenureMonths" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Live EMI Preview Card -->
                <div class="fg-preview-box">
                    <div class="fg-preview-header">
                        <i class="fa-solid fa-calculator me-1" aria-hidden="true"></i>
                        Live EMI & Repayment Calculator
                    </div>
                    <div class="fg-preview-row">
                        <span class="text-secondary">Estimated Monthly Installment (EMI):</span>
                        <strong id="previewEmi" class="num-tabular text-dark fs-5">₹0.00</strong>
                    </div>
                    <div class="fg-preview-row">
                        <span class="text-secondary">Total Scheduled Payable Amount:</span>
                        <strong id="previewTotal" class="num-tabular text-secondary fw-semibold">₹0.00</strong>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-4">
                    <a asp-action="Index" class="fg-btn fg-btn-secondary">Cancel</a>
                    <button type="submit" class="fg-btn fg-btn-primary">
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        <span>Disburse & Issue Loan</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const principalInput = document.getElementById('PrincipalAmount');
            const rateInput = document.getElementById('InterestRate');
            const tenureInput = document.getElementById('TenureMonths');
            const previewEmi = document.getElementById('previewEmi');
            const previewTotal = document.getElementById('previewTotal');

            function updatePreview() {
                const p = parseFloat(principalInput ? principalInput.value : 0) || 0;
                const yearlyRate = parseFloat(rateInput ? rateInput.value : 0) || 0;
                const n = Math.abs(parseInt(tenureInput ? tenureInput.value : 0, 10)) || 0;

                const r = (yearlyRate / 12) / 100;
                let emi = 0;

                if (r > 0 && n > 0) {
                    emi = (p * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
                } else if (n > 0) {
                    emi = p / n;
                }

                if (previewEmi) previewEmi.innerText = '₹' + emi.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (previewTotal) previewTotal.innerText = '₹' + (emi * n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            document.querySelectorAll('.calc-input').forEach(item => {
                item.addEventListener('input', updatePreview);
            });

            updatePreview();
        })();
    </script>
}