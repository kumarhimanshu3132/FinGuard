@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Page Header -->
<div class="fg-page-header">
    <div class="fg-page-title-group">
        <h1 class="fg-page-title">
            <i class="fa-solid fa-chart-pie text-secondary" style="font-size: 1.25rem;" aria-hidden="true"></i>
            Executive Overview
        </h1>
        <p class="fg-page-subtitle">Real-time portfolio metrics, disbursement volumes, and microfinance recovery health.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Customer" asp-action="Create" class="fg-btn fg-btn-secondary fg-btn-sm">
            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
            <span>Onboard Customer</span>
        </a>
        <a asp-controller="Loan" asp-action="Create" class="fg-btn fg-btn-primary fg-btn-sm">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Issue Loan</span>
        </a>
    </div>
</div>

<!-- Compact 4-Column KPI Grid -->
<div class="fg-kpi-grid">
    <!-- Total Disbursed Capital -->
    <div class="fg-kpi-card">
        <div class="fg-kpi-header">
            <span class="fg-kpi-label">Total Disbursed Capital</span>
            <div class="fg-kpi-icon indigo">
                <i class="fa-solid fa-wallet" aria-hidden="true"></i>
            </div>
        </div>
        <div class="fg-kpi-value num-tabular">₹@ViewBag.TotalDisbursed.ToString("N2")</div>
        <div class="fg-kpi-meta">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>Gross capital issued across all active & closed loans</span>
        </div>
    </div>

    <!-- Active Customers -->
    <div class="fg-kpi-card">
        <div class="fg-kpi-header">
            <span class="fg-kpi-label">Active Borrowers</span>
            <div class="fg-kpi-icon success">
                <i class="fa-solid fa-users" aria-hidden="true"></i>
            </div>
        </div>
        <div class="fg-kpi-value num-tabular">@ViewBag.ActiveCustomers</div>
        <div class="fg-kpi-meta">
            <i class="fa-solid fa-circle-check text-success" aria-hidden="true"></i>
            <span>Borrowers currently holding active credit status</span>
        </div>
    </div>

    <!-- Total Recovered -->
    <div class="fg-kpi-card">
        <div class="fg-kpi-header">
            <span class="fg-kpi-label">Total Collections Recovered</span>
            <div class="fg-kpi-icon indigo">
                <i class="fa-solid fa-hand-holding-dollar" aria-hidden="true"></i>
            </div>
        </div>
        <div class="fg-kpi-value num-tabular" style="color: var(--fg-success);">₹@ViewBag.TotalRecovered.ToString("N2")</div>
        <div class="fg-kpi-meta">
            <i class="fa-solid fa-arrow-down-long text-success" aria-hidden="true"></i>
            <span>Cumulative EMI receipts recorded in ledger</span>
        </div>
    </div>

    <!-- Defaulters -->
    <div class="fg-kpi-card">
        <div class="fg-kpi-header">
            <span class="fg-kpi-label">Delinquent Loans</span>
            <div class="fg-kpi-icon danger">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            </div>
        </div>
        <div class="fg-kpi-value num-tabular" style="color: @(ViewBag.Defaulters > 0 ? "var(--fg-danger)" : "var(--fg-text-primary)");">
            @ViewBag.Defaulters
        </div>
        <div class="fg-kpi-meta">
            <i class="fa-solid fa-shield-virus @(ViewBag.Defaulters > 0 ? "text-danger" : "text-muted")" aria-hidden="true"></i>
            <span>Loans classified in Defaulter status</span>
        </div>
    </div>
</div>

<!-- Operational Quick Actions -->
<div class="fg-card">
    <div class="fg-card-header">
        <h2 class="fg-card-title">
            <i class="fa-solid fa-bolt-lightning text-primary" aria-hidden="true"></i>
            Operational Quick Actions
        </h2>
        <span class="fg-count-badge">Core Management Workflows</span>
    </div>
    <div class="fg-card-body p-3">
        <div class="fg-action-grid">
            <a asp-controller="Customer" asp-action="Create" class="fg-action-item">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                <div class="fg-action-text">
                    <span class="fg-action-title">Onboard Customer</span>
                    <span class="fg-action-desc">Register borrower profile and verify contact details</span>
                </div>
            </a>

            <a asp-controller="Loan" asp-action="Create" class="fg-action-item">
                <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
                <div class="fg-action-text">
                    <span class="fg-action-title">Issue New Loan</span>
                    <span class="fg-action-desc">Configure principal, tenure, and calculate live EMI</span>
                </div>
            </a>

            <a asp-controller="Repayment" asp-action="Index" class="fg-action-item">
                <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                <div class="fg-action-text">
                    <span class="fg-action-title">Collect EMI Payment</span>
                    <span class="fg-action-desc">Process installment receipts from field agents</span>
                </div>
            </a>

            <a asp-controller="Loan" asp-action="Index" class="fg-action-item">
                <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                <div class="fg-action-text">
                    <span class="fg-action-title">Review Loan Book</span>
                    <span class="fg-action-desc">Inspect all active and closed lending accounts</span>
                </div>
            </a>
        </div>
    </div>
</div>